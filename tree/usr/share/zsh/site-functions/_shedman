#compdef shedman
# zsh completion for the shedman unified CLI.
#
# Subcommand list read at completion time from the verb declarations
# /etc/shedman/shedman.toml points at, descriptions included. Packages
# dropping new subcommands there become completable without reinstalling this
# file. Names prefixed with `_` (internal helpers) are hidden.
#
# Per-subcommand argument completion defers to `shedman <cmd>
# --complete-zsh` if the subcommand honors it. Every other subcommand
# falls back to filename completion.

_shedman_config() {
    # One `key = "value"` line out of shedman's config file, or the default
    # when the file is absent, unreadable or silent about the key.
    local value
    value=$(sed -n "s/^[[:space:]]*${1}[[:space:]]*=[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" \
        "${SHEDMAN_CONFIG:-/etc/shedman/shedman.toml}" 2>/dev/null | head -1)
    printf '%s\n' "${value:-$2}"
}

_shedman() {
    local -a _subcmds _builtin _flags
    local state line
    local libexec
    libexec=$(_shedman_config libexec /usr/libexec/shedman)

    _builtin=(
        'help:list subcommands or show --help for <cmd>'
        'version:print the installed shedman version'
    )

    local verbs
    verbs=$(_shedman_config verbs /usr/share/shedman/verbs.d)
    _subcmds=( ${(f)"$(awk -F'"' '
        function emit() { if (name != "" && name !~ /^_/) print name ":" desc }
        FILENAME != file { if (file != "") emit(); file = FILENAME; name = desc = "" }
        /^[[:space:]]*name[[:space:]]*=/        { name = $2 }
        /^[[:space:]]*description[[:space:]]*=/ { desc = $2 }
        END { emit() }
    ' $verbs/*.toml(N) 2>/dev/null | LC_ALL=C sort)"} )

    _arguments -C \
        '1: :->command' \
        '*:: :->args' \
    && return 0

    case $state in
        command)
            _describe -t builtin 'shedman built-in' _builtin
            _describe -t subcommands 'shedman subcommand' _subcmds
            ;;
        args)
            local cmd=$words[1]
            case $cmd in
                help)
                    _describe -t subcommands 'shedman subcommand' _subcmds
                    ;;
                version|--help|-h|--version|-V)
                    ;;
                *)
                    local bin=$libexec/$cmd
                    if [[ -x $bin ]]; then
                        local prev_word=""
                        if (( CURRENT > 2 )); then
                            prev_word=${words[CURRENT-1]}
                        fi
                        _flags=( "${(@f)$("$bin" --complete-zsh "$prev_word" 2>/dev/null)}" )
                        if (( ${#_flags} )); then
                            _describe -t completions "$cmd argument" _flags
                            return 0
                        fi
                    fi
                    _files
                    ;;
            esac
            ;;
    esac
}

_shedman "$@"

# bash completion for the shedman unified CLI.
#
# Subcommand list read at completion time from the verb declarations
# /etc/shedman/shedman.toml points at. Packages dropping new subcommands
# there become completable without reinstalling this file. Names prefixed
# with `_` (internal helpers) are hidden.
#
# Per-subcommand flag completion defers to `shedman <cmd>
# --complete-bash` if the subcommand honors it. Every other subcommand
# falls back to filename completion.
#
# Self-contained: no dependency on the bash-completion package's
# _init_completion / _filedir helpers.

_shedman_config() {
    # One `key = "value"` line out of shedman's config file, or the default
    # when the file is absent, unreadable or silent about the key.
    local value
    value=$(sed -n "s/^[[:space:]]*${1}[[:space:]]*=[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" \
        "${SHEDMAN_CONFIG:-/etc/shedman/shedman.toml}" 2>/dev/null | head -1)
    printf '%s\n' "${value:-$2}"
}

_shedman_verbs() {
    # Every declared verb name, internals left out.
    local dir
    dir=$(_shedman_config verbs /usr/share/shedman/verbs.d)
    sed -n 's/^[[:space:]]*name[[:space:]]*=[[:space:]]*"\([^_"][^"]*\)".*/\1/p' \
        "$dir"/*.toml 2>/dev/null | LC_ALL=C sort -u
}

_shedman() {
    local cur prev cword libexec
    libexec=$(_shedman_config libexec /usr/libexec/shedman)
    cword=$COMP_CWORD
    cur=${COMP_WORDS[cword]}
    prev=${COMP_WORDS[cword-1]-}

    # Position 1: enumerate subcommands + built-ins.
    if (( cword == 1 )); then
        local -a subcmds=()
        mapfile -t subcmds < <(_shedman_verbs)
        subcmds+=(help version)
        COMPREPLY=( $(compgen -W "${subcmds[*]}" -- "$cur") )
        return 0
    fi

    local cmd=${COMP_WORDS[1]}

    # `shedman help <tab>` completes with subcommand names.
    if [[ $cmd == help && $cword == 2 ]]; then
        local -a subcmds=()
        mapfile -t subcmds < <(_shedman_verbs)
        COMPREPLY=( $(compgen -W "${subcmds[*]}" -- "$cur") )
        return 0
    fi

    # Delegate to --complete-bash, passing the prev word for positional
    # completion (e.g. `shedman fingerprint enroll <tab>` returns finger
    # names). Subcommands that don't read the extra arg still work.
    local bin="$libexec/$cmd"
    if [[ -x $bin ]]; then
        local flags
        if (( cword > 2 )); then
            flags=$("$bin" --complete-bash "$prev" 2>/dev/null)
        else
            flags=$("$bin" --complete-bash 2>/dev/null)
        fi
        if [[ -n $flags ]]; then
            COMPREPLY=( $(compgen -W "$flags" -- "$cur") )
            return 0
        fi
    fi
    COMPREPLY=( $(compgen -f -- "$cur") )
}

complete -F _shedman shedman

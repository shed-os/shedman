#!/usr/bin/env python3
"""shedos-doctor — detect drift between /etc/shedos/system.toml and live state.

Read-only counterpart to ``shedman apply``. Reuses the same validator and
reconciler engine (``apply_core``) but never mutates — the planner returns
a list of would-be changes, and shedos-doctor reports them.

Modes:

    (no flag)          human-readable drift report + boot-safety audit
    --json             machine-readable drift report (incl. mount_safety, mount_missed)
    --diff             unified-diff view of every drift entry
    --fix              delegate to `shedman apply --yes`
    --fix-mounts       add nofail to risky fstab mounts (backup + confirm)
    --waybar           emit waybar-pill JSON (always exits 0)
    --tick             timer entry: notify + refresh waybar
    --notify-if-new    fire mako only if the drift fingerprint changed
    --reset-notify-state   clear the hysteresis file

Exit codes mirror the plan:

    0  aligned (system.toml matches live state, no unsafe mounts)
    1  drift detected, or an fstab mount lacks nofail (can wedge boot)
    2  error (missing config, schema violation, systemctl misbehavior)

Hysteresis file: /var/lib/shedos/doctor.state.json stores the last
plan fingerprint so ``--notify-if-new`` only fires once per drift
(silent when the same drift persists across ticks).

Env vars are forwarded to apply_core; ``SHEDOS_LIB_ROOT`` lets tests
point at the repo tree instead of /usr/lib/shedos.

Additional env hooks (tests only):

    SHEDOS_DOCTOR_NOTIFY_CMD   argv override for the mako call
    SHEDOS_DOCTOR_REFRESH_CMD  argv override for the waybar signal kick
    SHEDOS_DOCTOR_APPLY_CMD    argv override for ``--fix`` (default:
                               /usr/bin/shedman apply --yes)
"""

from __future__ import annotations

import argparse
import json
import os
import shlex
import subprocess
import sys
from pathlib import Path


if len(sys.argv) > 1 and sys.argv[1] == "--help-summary":
    print("report drift between /etc/shedos/system.toml and live state")
    sys.exit(0)

if len(sys.argv) > 1 and sys.argv[1] in ("--complete-bash", "--complete-zsh"):
    for _f in ("--config", "-c", "--json", "-j", "--diff", "-d",
               "--fix", "-f", "--fix-mounts", "--yes", "-y",
               "--waybar", "--tick", "--notify-if-new",
               "--reset-notify-state", "--help", "-h"):
        print(_f)
    sys.exit(0)
if len(sys.argv) > 1 and sys.argv[1] == "--complete-fish":
    for _flag, _desc in (
        ("--config",             "read system.toml from a custom path"),
        ("-c",                   "read system.toml from a custom path"),
        ("--json",               "emit machine-readable JSON"),
        ("-j",                   "emit machine-readable JSON"),
        ("--diff",               "render unified diffs for every drift entry"),
        ("-d",                   "render unified diffs for every drift entry"),
        ("--fix",                "delegate to shedman apply --yes"),
        ("-f",                   "delegate to shedman apply --yes"),
        ("--fix-mounts",         "add nofail to risky fstab mounts (backup + confirm)"),
        ("--yes",                "assume yes for --fix-mounts"),
        ("-y",                   "assume yes for --fix-mounts"),
        ("--waybar",             "JSON for waybar's custom/doctor module"),
        ("--tick",               "timer-driven entry; rc=0 even on drift"),
        ("--notify-if-new",      "fire a notification iff the drift fingerprint changed"),
        ("--reset-notify-state", "clear the hysteresis file"),
        ("--help",               "show usage"),
        ("-h",                   "show usage"),
    ):
        print(f"{_flag}\t{_desc}")
    sys.exit(0)

_LIB_ROOT = os.environ.get("SHEDOS_LIB_ROOT", "/usr/lib/shedos")
if _LIB_ROOT not in sys.path:
    sys.path.insert(0, _LIB_ROOT)

import apply_core as _core  # noqa: E402


DOCTOR_STATE = "doctor.state.json"


# Hysteresis: remember which drift fingerprint we last notified about
# so the timer-driven invocation doesn't spam the same message every
# 6 hours.
def _doctor_state_path() -> Path:
    # The notify hysteresis is per-invoker: root keeps the system state
    # dir; a regular user (the waybar/mako notify path, plain doctor)
    # gets an XDG state file it can actually write. An explicit state
    # root override (tests, sandboxes) wins either way.
    if os.environ.get("SHEDOS_APPLY_STATE_ROOT") or os.geteuid() == 0:
        return _core.state_root() / DOCTOR_STATE
    xdg = os.environ.get("XDG_STATE_HOME",
                         str(Path.home() / ".local" / "state"))
    return Path(xdg) / "shedos" / DOCTOR_STATE


def _load_state() -> dict:
    p = _doctor_state_path()
    try:
        doc = json.loads(p.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}
    return doc if isinstance(doc, dict) else {}


def _save_state(state: dict) -> None:
    p = _doctor_state_path()
    try:
        p.parent.mkdir(parents=True, exist_ok=True)
        _core.atomic_write_text(
            p, json.dumps(state, indent=2) + "\n", mode=0o644)
    except OSError as e:
        # Hysteresis is best-effort; never let it break doctor itself.
        print(f"shedman doctor: cannot persist notify state: {e}",
              file=sys.stderr)


# Two keys in the one state file: drift and missed-disk fingerprints.
# Read-modify-write so neither clobbers the other.
def _load_last_hash() -> str:
    v = _load_state().get("last_notified_hash", "")
    return v if isinstance(v, str) else ""


def _save_last_hash(hash_value: str) -> None:
    state = _load_state()
    state["last_notified_hash"] = hash_value
    _save_state(state)


def _load_last_missed() -> str:
    v = _load_state().get("last_missed_fp", "")
    return v if isinstance(v, str) else ""


def _save_last_missed(fp: str) -> None:
    state = _load_state()
    state["last_missed_fp"] = fp
    _save_state(state)


# Plan acquisition: shared entry for every mode. Returns (rc, plan)
# where rc is 0=aligned, 1=drift, 2=error. On rc==2 plan is None and an
# error has already been printed to stderr.
def _compute_plan(cfg_path: "_core.Optional[Path]") -> tuple[int, "_core.Optional[_core.Plan]"]:
    try:
        cfg = _core.load_config(cfg_path)
    except FileNotFoundError as e:
        print(f"shedman doctor: {e}", file=sys.stderr)
        return 2, None
    except _core.SchemaError as e:
        print(f"shedman doctor: {e}", file=sys.stderr)
        return 2, None
    try:
        manifest = _core.Manifest.load()
        plan, _ = _core.build_plan(cfg, manifest)
    except Exception as e:
        print(f"shedman doctor: plan failed: {e}", file=sys.stderr)
        return 2, None
    return (0 if plan.is_empty() else 1), plan


# Subprocess hooks: env-overridable for tests.
def _notify_send(title: str, body: str, urgency: str = "normal") -> None:
    override = os.environ.get("SHEDOS_DOCTOR_NOTIFY_CMD")
    if override is not None:
        # urgency last so a stub reading $0/$1 is unaffected.
        cmd = shlex.split(override) + [title, body, urgency]
    else:
        cmd = ["notify-send", "-a", "shedman doctor", "-u", urgency,
               title, body]
    try:
        subprocess.run(cmd, check=False, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        pass


def _refresh_waybar() -> None:
    override = os.environ.get("SHEDOS_DOCTOR_REFRESH_CMD")
    if override is not None:
        cmd = shlex.split(override)
    else:
        # SIGRTMIN+12: slot 12 (updates=8, conflicts=9, health=10,
        # screenrecording=11, doctor=12). Slot 11 was claimed here
        # before, colliding with the screenrecording indicator.
        cmd = ["pkill", "-RTMIN+12", "waybar"]
    try:
        subprocess.run(cmd, check=False, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        pass


def _delegate_apply(cfg_path: "_core.Optional[Path]") -> int:
    override = os.environ.get("SHEDOS_DOCTOR_APPLY_CMD")
    if override is not None:
        cmd = shlex.split(override)
    else:
        cmd = ["/usr/bin/shedman", "apply", "--yes"]
    if cfg_path is not None:
        cmd += ["--config", str(cfg_path)]
    try:
        r = subprocess.run(cmd, check=False)
    except OSError as e:
        print(f"shedman doctor: cannot exec shedman apply: {e}", file=sys.stderr)
        return 2
    return r.returncode


def _emit_human(plan: _core.Plan) -> None:
    if plan.is_empty():
        print(_core.colorize("aligned — no drift detected.", "green"))
        for n in plan.notes:
            print(f"  {_core.colorize('?', 'yellow')} {n}")
        return
    n = len(plan.visible_changes())
    print(_core.colorize(
        f"drift — {n} item(s) differ from /etc/shedos/system.toml:",
        "yellow"))
    print(plan.render())
    print()
    print(_core.colorize(
        "Run `shedman doctor --diff` for unified diffs, "
        "or `shedman doctor --fix` to apply.",
        "dim"))


def _emit_json(plan: _core.Plan, findings: list, missed: list,
               bootsec: list) -> None:
    doc = plan.to_json()
    doc["plan_hash"] = _core.plan_hash(plan)
    doc["mount_safety"] = [
        {"target": f.target, "device": f.device,
         "fstype": f.fstype, "reason": f.reason}
        for f in findings
    ]
    doc["mount_missed"] = missed
    doc["secure_boot"] = bootsec
    print(json.dumps(doc, indent=2, sort_keys=True))


def _emit_diff(plan: _core.Plan) -> None:
    if plan.is_empty():
        print("aligned — no drift.")
        return
    print(plan.render_diffs())


def _audit_mount_safety() -> list:
    """Read the live fstab and return boot-safety findings — non-root mounts
    on a separate filesystem that lack `nofail` and would drop the system to
    emergency mode if their device is absent at boot. Empty on a missing or
    unreadable fstab."""
    try:
        fstab = _core.fstab_path()
        if not fstab.exists():
            return []
        return _core.audit_fstab_mount_safety(fstab.read_text(encoding="utf-8"))
    except OSError:
        return []


def _emit_mount_safety_human(findings: list) -> None:
    if not findings:
        return
    print()
    print(_core.colorize(
        "boot safety — fstab mount(s) that can wedge boot:", "yellow"))
    for f in findings:
        print(f"  {_core.colorize('!', 'yellow')} {f.target}  ({f.device})")
        print(f"      {f.reason}")
    print(_core.colorize("  fix: sudo shedman doctor --fix-mounts", "dim"))


def _audit_mount_missed() -> list:
    """Read the breadcrumb shedos-mount-report leaves: auto fstab mounts that
    didn't mount this boot. Empty when absent."""
    path = Path(os.environ.get("SHEDOS_MOUNT_REPORT_STATE",
                               "/var/lib/shedos/mount-missed.json"))
    try:
        doc = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return []
    missed = doc.get("missed", []) if isinstance(doc, dict) else []
    return missed if isinstance(missed, list) else []


def _emit_mount_missed_human(missed: list) -> None:
    if not missed:
        return
    print()
    print(_core.colorize(
        "boot safety — disk(s) that did not mount this boot:", "yellow"))
    for m in missed:
        print(f"  {_core.colorize('!', 'yellow')} {m.get('target', '?')}  "
              f"({m.get('device', '?')})")
        print("      its disk was missing at boot, so this nofail mount was "
              "skipped; reconnect or repair the disk to restore it")


def _missed_fingerprint(missed: list) -> str:
    return ",".join(sorted(m.get("target", "") for m in missed))


# ── Secure Boot / signed-UKI audit ────────────────────────────────────────
# Firmware Secure Boot state lives in world-readable efivars, so the user-
# session waybar tick can read it; the signing intent lives in uki.conf (also
# world-readable). Verifying a UKI's signature needs the 0400 db cert, so that
# half only runs where the cert is readable — root in production, or a stub in
# the suite. Every input is sandboxed (etc-root + the env overrides below) so a
# box that never enrolled short-circuits before touching the efivar, which keeps
# the unrelated cases hermetic and non-root.
_EFI_GLOBAL_GUID = "8be4df61-93ca-11d2-aa0d-00e098032b8c"


def _uki_conf_signing() -> bool:
    """True when uki.conf names a SecureBootCertificate — this box opted into
    Secure Boot. The keyless default (and `secureboot disable`) returns False,
    so a box that never enrolled is never flagged."""
    path = Path(os.environ.get("SHEDOS_DOCTOR_UKI_CONF",
                               str(_core.etc_root() / "kernel" / "uki.conf")))
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return False
    return any(ln.lstrip().startswith("SecureBootCertificate=")
               for ln in text.splitlines())


def _efivar_bool(name: str) -> "bool | None":
    """A 1-byte EFI bool var (4-byte attribute prefix + value). None when the
    var is absent or unreadable — a BIOS box has no efivars."""
    raw = os.environ.get(f"SHEDOS_DOCTOR_{name.upper()}_EFIVAR")
    path = (Path(raw) if raw else
            Path("/sys/firmware/efi/efivars") / f"{name}-{_EFI_GLOBAL_GUID}")
    try:
        data = path.read_bytes()
    except OSError:
        return None
    return len(data) >= 5 and data[4] == 1


def _audit_secureboot() -> list:
    """A box set up for Secure Boot (signing uki.conf) but booting with it off,
    so the chain is no longer verified. Read-only and non-root. Empty on a box
    that never enrolled, on BIOS, or when Secure Boot is on."""
    if not _uki_conf_signing():
        return []
    sb_on = _efivar_bool("SecureBoot")
    if sb_on is None or sb_on:
        return []
    if _efivar_bool("SetupMode"):
        return ["Secure Boot is set up for this machine but firmware keys were "
                "cleared (Setup Mode); the boot chain is not verified — run "
                "`shedman secureboot enroll` to re-enroll"]
    return ["Secure Boot is set up for this machine but is currently off; the "
            "boot chain is not verified — turn it back on in firmware, or run "
            "`shedman secureboot disable` to stop enforcing"]


def _audit_uki_signatures() -> list:
    """A placed boot image that does not verify against this box's Secure Boot
    cert. Only runs where the cert is readable (root's 0400 db.pem, or a stub);
    empty otherwise, since uki-place.sh refuses to place an unverifiable signed
    UKI. The case it earns: a key re-enroll leaves the prior UKIs signed by the
    old key until the next kernel rebuild re-signs them."""
    if not _uki_conf_signing():
        return []
    cert = os.environ.get("SHEDOS_DOCTOR_DB_CERT",
                          "/var/lib/sbctl/keys/db/db.pem")
    if not os.access(cert, os.R_OK):
        return []
    sbverify = os.environ.get("SHEDOS_DOCTOR_SBVERIFY", "sbverify")
    roots = os.environ.get("SHEDOS_DOCTOR_ESP_DIRS", "/boot/efi /efi").split()
    bad = []
    for r in roots:
        for uki in sorted(Path(r, "EFI", "Linux").glob("shedos-*.efi")):
            try:
                rc = subprocess.run([sbverify, "--cert", cert, str(uki)],
                                    capture_output=True).returncode
            except OSError:
                return []
            if rc != 0:
                bad.append(f"boot image {uki.name} is not validly signed for "
                           "Secure Boot — run `shedman secureboot repair`")
    return bad


def _emit_secureboot_human(bootsec: list) -> None:
    if not bootsec:
        return
    print()
    print(_core.colorize("boot security — Secure Boot needs attention:",
                         "yellow"))
    for b in bootsec:
        print(f"  {_core.colorize('!', 'yellow')} {b}")


def _fix_mounts(assume_yes: bool) -> int:
    """Add `nofail` to risky fstab mounts, with a backup and confirmation.
    Distinct from --fix (which delegates to `shedman apply` and only touches
    the managed fence): this repairs hand-added entries living OUTSIDE the
    fence — the class that silently bricks boot."""
    findings = _audit_mount_safety()
    if not findings:
        print(_core.colorize("no unsafe mounts — nothing to fix.", "green"))
        return 0
    fstab = _core.fstab_path()
    print(_core.colorize(
        f"{len(findings)} fstab mount(s) lack nofail and can wedge boot:",
        "yellow"))
    for f in findings:
        print(f"  {f.target}  ({f.device})")
    print()
    print("Proposed: add `nofail,x-systemd.device-timeout=5s` to each.")
    if not assume_yes:
        try:
            resp = input("Proceed? [y/N] ").strip().lower()
        except EOFError:
            resp = ""
        if resp not in ("y", "yes"):
            print("aborted; no changes made.")
            return 0
    try:
        text = fstab.read_text(encoding="utf-8")
    except OSError as e:
        print(f"shedman doctor: cannot read {fstab}: {e}", file=sys.stderr)
        return 2
    new_text = _core.add_nofail_to_fstab(text, [f.target for f in findings])
    # Invariant: only options change — never lose or add a line. Refuse if
    # the structure shifted (it shouldn't) so we never write a broken fstab.
    if len(new_text.splitlines()) != len(text.splitlines()):
        print("shedman doctor: refusing to write — fstab line count changed",
              file=sys.stderr)
        return 2
    backup = fstab.with_name(fstab.name + ".shedos-bak")
    try:
        backup.write_text(text, encoding="utf-8")
        fstab.write_text(new_text, encoding="utf-8")
    except OSError as e:
        print(f"shedman doctor: cannot write {fstab}: {e}", file=sys.stderr)
        return 2
    print(_core.colorize(
        f"fixed {len(findings)} mount(s); backup at {backup}", "green"))
    print("run `sudo systemctl daemon-reload` to apply.")
    return 0


def _waybar_payload(plan: _core.Plan, findings: list, missed: list,
                    bootsec: list) -> dict[str, str]:
    """Waybar JSON contract: {text, tooltip, class, alt}.

    The most severe active level sets the pill. The tooltip lists the rest:
      critical  a disk did not mount this boot
      warning   an fstab mount lacks nofail and can wedge a future boot
      bootsec   Secure Boot is set up but off, or a UKI does not verify
      drift     config drift only
      aligned   nothing
    """
    drift = plan.visible_changes()
    drift_tail = f"\\n{len(drift)} drift item(s)" if drift else ""

    if missed:
        n = len(missed)
        rows = [f"{m.get('target', '?')}  ({m.get('device', '?')})"
                for m in missed[:8]]
        body = r"\n".join(rows).replace('"', r'\"')
        return {
            "text": f" {n}",  #  = nf-fa-triangle_exclamation
            "tooltip": (f"shedman doctor: {n} disk(s) did not mount this "
                        f"boot\\n{body}{drift_tail}"),
            "class": "critical",
            "alt": "critical",
        }

    if findings:
        n = len(findings)
        rows = [f"{f.target}  ({f.device}) — {f.reason}" for f in findings[:8]]
        body = r"\n".join(rows).replace('"', r'\"')
        return {
            "text": f" {n}",  #  = nf-fa-triangle_exclamation
            "tooltip": (f"shedman doctor: {n} mount(s) can wedge boot "
                        f"(missing nofail)\\n{body}{drift_tail}"),
            "class": "warning",
            "alt": "warning",
        }

    if bootsec:
        n = len(bootsec)
        body = (r"\n".join(bootsec[:8])).replace('"', r'\"')
        return {
            "text": f"\uf023 {n}",  # \uf023 = nf-fa-lock
            "tooltip": ("shedman doctor: Secure Boot needs attention"
                        f"\\n{body}{drift_tail}"),
            "class": "bootsec",
            "alt": "bootsec",
        }

    if not drift:
        return {"text": "", "tooltip": "system state aligned",
                "class": "aligned", "alt": "aligned"}

    n = len(drift)
    # One-per-line tooltip mirroring shedos-check-health's style.
    lines = [f"{c.kind} [{c.section}] {c.summary}" for c in drift[:8]]
    if len(drift) > 8:
        lines.append(f"… and {len(drift) - 8} more")
    tooltip = r"\n".join(lines).replace('"', r'\"')
    return {
        "text": f" {n}",  #  = stethoscope (nf-fa-stethoscope)
        "tooltip": f"shedman doctor: {n} drift item(s)\\n{tooltip}",
        "class": "drift",
        "alt": "drift",
    }


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="shedman doctor",
        description="Report drift between /etc/shedos/system.toml and live state.",
    )
    parser.add_argument("--config", "-c", type=Path, default=None,
                        help="path to system.toml "
                             "(default: /etc/shedos/system.toml)")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--json", "-j", action="store_true",
                      help="emit drift report as JSON")
    mode.add_argument("--diff", "-d", action="store_true",
                      help="emit unified diffs for each drift entry")
    mode.add_argument("--fix", "-f", action="store_true",
                      help="delegate to `shedman apply --yes`")
    mode.add_argument("--waybar", action="store_true",
                      help="emit waybar custom-module JSON (always exits 0)")
    mode.add_argument("--tick", action="store_true",
                      help="timer entry: notify-if-new + refresh waybar "
                           "(always exits 0)")
    mode.add_argument("--notify-if-new", action="store_true",
                      help="fire mako iff the drift fingerprint changed")
    mode.add_argument("--reset-notify-state", action="store_true",
                      help="clear the hysteresis state file")
    mode.add_argument("--fix-mounts", action="store_true",
                      help="add nofail to risky fstab mounts (backup + confirm)")
    parser.add_argument("--yes", "-y", action="store_true",
                        help="assume yes for --fix-mounts (non-interactive)")
    args = parser.parse_args()

    if args.reset_notify_state:
        _save_state({})
        return 0

    if args.fix:
        return _delegate_apply(args.config)

    if args.fix_mounts:
        return _fix_mounts(args.yes)

    rc, plan = _compute_plan(args.config)
    if rc == 2:
        return 2
    assert plan is not None

    # A risky mount or a disk that didn't mount is an attention condition
    # like drift, so exit 1.
    findings = _audit_mount_safety()
    missed = _audit_mount_missed()
    bootsec = _audit_secureboot() + _audit_uki_signatures()
    attn_rc = 1 if (rc == 1 or findings or missed or bootsec) else 0

    if args.waybar:
        print(json.dumps(_waybar_payload(plan, findings, missed, bootsec)))
        return 0

    if args.json:
        _emit_json(plan, findings, missed, bootsec)
        return attn_rc

    if args.diff:
        _emit_diff(plan)
        _emit_mount_safety_human(findings)
        _emit_mount_missed_human(missed)
        _emit_secureboot_human(bootsec)
        return attn_rc

    if args.notify_if_new or args.tick:
        current_hash = _core.plan_hash(plan)
        last = _load_last_hash()
        if not plan.is_empty() and current_hash != last:
            visible = plan.visible_changes()
            n = len(visible)
            body_lines = [f"{c.kind} {c.summary}" for c in visible[:4]]
            if len(visible) > 4:
                body_lines.append(f"… and {len(visible) - 4} more")
            _notify_send(
                f"ShedOS: {n} config item(s) have drifted",
                "\n".join(body_lines) +
                "\n\nRun `shedman apply` or `shedman doctor --diff`.",
            )
            _save_last_hash(current_hash)
        elif plan.is_empty() and last:
            # Drift cleared; clear the state so the next drift fires.
            _save_last_hash("")
        # A missed disk fires a critical notice, with its own fingerprint so
        # it doesn't repeat every tick.
        missed_fp = _missed_fingerprint(missed)
        if missed and missed_fp != _load_last_missed():
            body_lines = [f"{m.get('target', '?')}  ({m.get('device', '?')})"
                          for m in missed[:4]]
            if len(missed) > 4:
                body_lines.append(f"… and {len(missed) - 4} more")
            _notify_send(
                "ShedOS: a disk did not mount this boot",
                "\n".join(body_lines) +
                "\n\nReconnect or repair the disk, then run `shedman doctor`.",
                urgency="critical",
            )
            _save_last_missed(missed_fp)
        elif not missed and _load_last_missed():
            _save_last_missed("")
        if args.tick:
            _refresh_waybar()
        return 0

    _emit_human(plan)
    _emit_mount_safety_human(findings)
    _emit_mount_missed_human(missed)
    _emit_secureboot_human(bootsec)
    return attn_rc


if __name__ == "__main__":
    raise SystemExit(main())

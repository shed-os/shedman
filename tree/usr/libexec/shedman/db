#!/usr/bin/env bash
# shedman db; umbrella for database-service bootstrap/admin tools.
#
# Modes (flag-style dispatch; each mode is a self-contained action):
#   --pg-bootstrap     Ensure each regular Linux user has a matching
#                      postgres LOGIN+CREATEDB role and a same-named
#                      database they own. Idempotent. Called on boot
#                      by shedos-pg-user-bootstrap.service.
#   create/drop/list   Per-project databases, run as the invoking user
#                      (whose role has CREATEDB from the bootstrap).

set -u


# Completion contract: answer statically, never run the tool's work.
case "${1:-}" in
    --complete-bash|--complete-zsh)
        printf '%s\n' create drop list --pg-bootstrap --help -h
        exit 0
        ;;
    --complete-fish)
        cat <<'COMPEOF'
create	create a project database
drop	drop a project database (asks first)
list	list your databases with sizes
--pg-bootstrap	bootstrap per-user postgres roles and databases
--help	show usage
COMPEOF
        exit 0
        ;;
esac
_usage() {
    cat <<'EOF'
usage: shedman db <create|drop> <name>
       shedman db list
       sudo shedman db --pg-bootstrap

Database-service bootstrap/admin tools.

Commands (run as you; your role owns what it creates):
  create <name>    Create a project database.
  drop <name>      Drop one — asks for confirmation first.
  list             Your databases, with sizes.

Modes:
  --pg-bootstrap   Bootstrap per-user postgres roles and databases.
EOF
}

_valid_name() {
    [[ $1 =~ ^[a-z_][a-z0-9_-]{0,62}$ ]]
}

_pg_up() {
    if ! pg_isready -q 2>/dev/null; then
        echo "shedman db: PostgreSQL is not running (try: sudo shedman services --fix)" >&2
        exit 1
    fi
}

case "${1:-}" in
    --help-summary)
        echo "database-service bootstrap/admin tools"
        exit 0
        ;;
    -h|--help|"")
        _usage
        [[ -z "${1:-}" ]] && exit 2 || exit 0
        ;;
    --pg-bootstrap)
        : # fall through to the pg bootstrap body below
        ;;
    create)
        name=${2:-}
        if [[ -z $name ]] || ! _valid_name "$name"; then
            echo "shedman db: name must be lowercase letters/digits/_/- (got '${name:-}')" >&2
            exit 2
        fi
        _pg_up
        if psql -ltqA 2>/dev/null | cut -d'|' -f1 | grep -qx "$name"; then
            echo "Database \"$name\" already exists."
            exit 0
        fi
        if createdb "$name"; then
            echo "Database \"$name\" created. Connect with: psql $name"
        else
            echo "shedman db: createdb failed (does your role exist? sudo shedman db --pg-bootstrap)" >&2
            exit 1
        fi
        exit 0
        ;;
    drop)
        name=${2:-}
        if [[ -z $name ]] || ! _valid_name "$name"; then
            echo "shedman db: name must be lowercase letters/digits/_/- (got '${name:-}')" >&2
            exit 2
        fi
        if [[ $name == "$USER" ]]; then
            echo "shedman db: refusing to drop your personal default database" >&2
            exit 1
        fi
        _pg_up
        if ! psql -ltqA 2>/dev/null | cut -d'|' -f1 | grep -qx "$name"; then
            echo "shedman db: no database named \"$name\"" >&2
            exit 1
        fi
        printf 'Drop database "%s" and everything in it? [y/N] ' "$name"
        read -r answer
        case $answer in
            y|Y|yes|YES)
                dropdb "$name" && echo "Database \"$name\" dropped."
                ;;
            *)
                echo "Cancelled."
                ;;
        esac
        exit 0
        ;;
    list)
        _pg_up
        psql -tA -F$'\t' -c \
            "SELECT d.datname, pg_size_pretty(pg_database_size(d.datname))
             FROM pg_database d
             WHERE NOT d.datistemplate
               AND pg_catalog.pg_get_userbyid(d.datdba) = current_user
             ORDER BY d.datname" 2>/dev/null \
            | awk -F'\t' 'BEGIN { printf "%-32s %s\n", "DATABASE", "SIZE" }
                           { printf "%-32s %s\n", $1, $2 }'
        exit 0
        ;;
    *)
        echo "shedman db: unknown mode '$1'" >&2
        _usage >&2
        exit 2
        ;;
esac

# --pg-bootstrap implementation
#
# Belt-and-suspenders for the Calamares-time bootstrap in shedos_finalize:
# if that fails silently for any reason, this oneshot unit catches it on
# first (and every) boot. Idempotent: existing roles/databases are left
# alone. No password is set; Arch's default pg_hba has `local all all
# peer` so the OS user connects with no flags; they can set a password
# later with psql \password if they want TCP auth.

# Type=notify on postgresql.service means the unit reports active only when
# postgres is actually accepting connections; but we still do a short
# pg_isready spin as belt-and-suspenders, because we're also reachable via
# manual invocation.
for _ in $(seq 1 30); do
    if runuser -u postgres -- pg_isready -q -h /run/postgresql 2>/dev/null; then
        break
    fi
    sleep 1
done

if ! runuser -u postgres -- pg_isready -q -h /run/postgresql 2>/dev/null; then
    echo "shedman db --pg-bootstrap: postgresql not ready after 30s; aborting" >&2
    exit 0   # don't fail the boot; postgres might simply be disabled
fi

# Regular users: UID 1000..59999 (system users are <1000, nobody is 65534).
getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 { print $1 }' | while IFS= read -r user; do
    [[ -z "$user" ]] && continue
    # Only bootstrap POSIX-valid names; anything else can't be safely
    # interpolated into the role/database SQL below.
    if [[ ! "$user" =~ ^[a-z_][a-z0-9_-]*$ ]]; then
        echo "shedman db --pg-bootstrap: skipping invalid username '$user'" >&2
        continue
    fi

    role_exists=$(runuser -u postgres -- psql -tAX \
        -c "SELECT 1 FROM pg_roles WHERE rolname = '${user}'" 2>/dev/null || true)
    if [[ "$role_exists" != "1" ]]; then
        echo "shedman db --pg-bootstrap: creating role $user"
        runuser -u postgres -- psql -v ON_ERROR_STOP=1 \
            -c "CREATE ROLE \"$user\" WITH LOGIN CREATEDB;" || {
                echo "shedman db --pg-bootstrap: CREATE ROLE $user failed" >&2
                continue
            }
    fi

    db_exists=$(runuser -u postgres -- psql -tAX \
        -c "SELECT 1 FROM pg_database WHERE datname = '${user}'" 2>/dev/null || true)
    if [[ "$db_exists" != "1" ]]; then
        echo "shedman db --pg-bootstrap: creating database $user owner $user"
        runuser -u postgres -- psql -v ON_ERROR_STOP=1 \
            -c "CREATE DATABASE \"$user\" OWNER \"$user\";" || {
                echo "shedman db --pg-bootstrap: CREATE DATABASE $user failed" >&2
            }
    fi
done

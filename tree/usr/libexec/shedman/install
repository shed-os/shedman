#!/bin/bash
# Install packages from official Arch repos, [shedos], or AUR.
# Source detection runs per-package: pacman first, then yay/AUR.

set -euo pipefail

usage() {
    cat <<'EOF'
Usage:
  shedman install <pkg> [<pkg>...]      Install one or more packages.
  shedman install -s|--search <query>   Search across pacman + AUR.
  shedman install -h|--help             Show this message.

Per-package source detection:
  1. pacman -Si  (official + [shedos])
  2. yay -Si     (AUR fallback; yay must be installed)
EOF
}

if [[ $# -eq 0 ]]; then
    usage
    exit 1
fi

case "$1" in
    -h|--help)
        usage
        exit 0
        ;;
    --help-summary)
        echo "install packages from official, shedos, or AUR repos"
        exit 0
        ;;
    -s|--search)
        shift
        if [[ $# -eq 0 ]]; then
            echo "shedman install: --search needs a query" >&2
            exit 1
        fi
        echo "=== pacman ==="
        pacman -Ss "$@" || true
        echo
        echo "=== AUR ==="
        if command -v yay >/dev/null 2>&1; then
            yay -Ss --aur "$@" || true
        else
            echo "(yay not installed; pacman -S yay to enable AUR search)"
        fi
        exit 0
        ;;
esac

if [[ $(id -u) -eq 0 ]]; then
    echo "shedman install: don't run as root — yay drops privileges itself" >&2
    exit 2
fi

pkgs=("$@")
pacman_pkgs=()
aur_pkgs=()
unknown=()

for pkg in "${pkgs[@]}"; do
    if pacman -Si "$pkg" >/dev/null 2>&1; then
        pacman_pkgs+=("$pkg")
    elif command -v yay >/dev/null 2>&1 && yay -Si --aur "$pkg" >/dev/null 2>&1; then
        aur_pkgs+=("$pkg")
    else
        unknown+=("$pkg")
    fi
done

if [[ ${#unknown[@]} -gt 0 ]]; then
    echo "shedman install: not found in any repo: ${unknown[*]}" >&2
    exit 1
fi

if [[ ${#pacman_pkgs[@]} -gt 0 ]]; then
    sudo pacman -S --needed --noconfirm "${pacman_pkgs[@]}"
fi

if [[ ${#aur_pkgs[@]} -gt 0 ]]; then
    if ! command -v yay >/dev/null 2>&1; then
        echo "shedman install: AUR packages found but yay missing: ${aur_pkgs[*]}" >&2
        echo "Install yay first: pacman -S yay" >&2
        exit 1
    fi
    # No --noconfirm/--answerdiff N/--skippgpcheck: AUR packages are
    # arbitrary user-submitted build scripts, so the user gets yay's
    # normal review prompts and makepkg verifies PGP signatures where
    # the PKGBUILD declares them. Hands-off installs were installing
    # unreviewed, unverified sources.
    yay -S --needed \
        --cleanafter --removemake \
        "${aur_pkgs[@]}"
fi

#!/bin/bash
# shedos-apps-installer — opt-in installer for proprietary AUR apps that
# ShedOS can't redistribute (VS Code, Chrome, Slack, …). Runs as step 2 of
# the first-boot welcome flow and stays re-runnable from the app launcher.
#
# UX contract:
#   1. If offline, surface a clear "connect to WiFi" screen with a button
#      that opens nm-connection-editor; retry after the user connects.
#   2. Present a single checklist grouped by category, everything
#      unchecked by default. Skip is always free.
#   3. Install selected packages with yay in a visible kitty window so the
#      user sees every PKGBUILD review / sudo prompt yay emits. We never
#      pass --noconfirm — the user's PGP trust and build-time prompts are
#      theirs to answer.
#   4. On success, drop a marker so the welcome flow won't re-launch this.
#      Partial/failed installs leave the marker off so the user can retry.
#
# Exits 0 on success, skip, or "no apps selected". Non-zero only on
# unrecoverable errors (refused to run as root, catalog missing, etc.).

set -u
# Intentionally no `-e`: yad returns non-zero on Cancel, which is normal.

if [[ "${1:-}" == "--help-summary" ]]; then
    echo "opt-in installer for proprietary AUR apps (VS Code, Chrome, …)"
    exit 0
fi

# Catalog resolution, in priority order:
#   1. $SHEDOS_APPS_CATALOG if set (explicit dev override)
#   2. /usr/share/shedos/apps-catalog.tsv (installed package)
#   3. ../../share/shedos/apps-catalog.tsv relative to this script
#      (in-tree dev checkout layout:
#       tree/usr/libexec/shedman/install → tree/usr/share/shedos/)
#
# The script-relative fallback means `bash path/to/install` works from a
# git checkout with zero env setup. The `../../` is load-bearing — `..`
# alone gets us to tree/usr/libexec/, not tree/usr/.
_self="$(readlink -f -- "$0" 2>/dev/null || echo "$0")"
_self_dir="$(dirname -- "$_self")"
if [[ -n "${SHEDOS_APPS_CATALOG:-}" ]]; then
    CATALOG="$SHEDOS_APPS_CATALOG"
elif [[ -r "/usr/share/shedos/apps-catalog.tsv" ]]; then
    CATALOG="/usr/share/shedos/apps-catalog.tsv"
elif [[ -r "$_self_dir/../../share/shedos/apps-catalog.tsv" ]]; then
    CATALOG="$_self_dir/../../share/shedos/apps-catalog.tsv"
else
    CATALOG="/usr/share/shedos/apps-catalog.tsv"   # for the error message
fi
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/shedos"
MARKER="$STATE_DIR/apps-installer-done"

FORCE=0
DRY_RUN=0
for arg in "$@"; do
    case "$arg" in
        --force|-f) FORCE=1 ;;
        --dry-run|-n) DRY_RUN=1 ;;
        --help|-h)
            cat <<EOF
Usage: shedman install [--force] [--dry-run]

Opt-in installer for proprietary apps (VS Code, Chrome, Slack, …) that
can't be bundled in the default ShedOS image.

  -f, --force     Re-run even if the first-boot step has already completed.
  -n, --dry-run   Walk the UI but print the yay command instead of running
                  it. Writes no marker. Useful for dev testing.
  -h, --help      Show this message.

Environment:
  SHEDOS_APPS_CATALOG   Override the catalog path (dev testing).
EOF
            exit 0
            ;;
    esac
done

# ---- Guard rails -----------------------------------------------------------

# Don't run in the live ISO or during Calamares.
if [[ -d /run/archiso ]] || \
   { [[ "${USER:-}" == "shedos" ]] && [[ -f /etc/calamares/settings.conf ]]; }; then
    exit 0
fi

# Refuse root — yay itself refuses, but fail fast with a clearer message.
if [[ "$(id -u)" -eq 0 ]]; then
    yad --error --title="ShedOS Apps" --width=380 --center --button="OK!gtk-ok:0" \
        --text="Don't run this as root.\n\nyay builds AUR packages as a regular user and calls sudo itself." \
        2>/dev/null || \
        echo "shedman install: refuse to run as root" >&2
    exit 2
fi

if [[ ! -r "$CATALOG" ]]; then
    yad --error --title="ShedOS Apps" --width=380 --center --button="OK!gtk-ok:0" \
        --text="App catalog missing:\n<tt>$CATALOG</tt>\n\nThis is a packaging bug — please report it." \
        2>/dev/null
    exit 1
fi

if [[ -f "$MARKER" && $FORCE -eq 0 ]]; then
    exit 0
fi

if ! command -v yad >/dev/null 2>&1; then
    echo "shedman install: yad is required" >&2
    exit 1
fi

mkdir -p "$STATE_DIR"

# ---- Network check ---------------------------------------------------------

check_connectivity() {
    # nmcli's connectivity states: full | limited | portal | none | unknown.
    # Only "full" guarantees AUR + vendor CDNs are reachable.
    local state=""
    if command -v nmcli >/dev/null 2>&1; then
        state=$(nmcli -t -f CONNECTIVITY general 2>/dev/null | head -n1)
    fi
    if [[ "$state" == "full" ]]; then
        return 0
    fi
    # Fallback probe if NetworkManager isn't answering (custom setups).
    if curl -fsS --max-time 4 https://aur.archlinux.org/ >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

prompt_connect() {
    # Loop until the user either gets online or gives up. Offering the
    # actual connection UI here beats a dead-end "connect to WiFi" toast.
    while true; do
        local resp
        yad --question \
            --title="ShedOS Apps — No internet" \
            --width=440 --center \
            --window-icon=network-offline \
            --image=network-offline \
            --text="<b>You're offline.</b>\n\nThese apps are downloaded from vendor sites and the AUR, so a working internet connection is required.\n\nConnect to a network, then retry." \
            --button="Skip for now:2" \
            --button="Open network settings:1" \
            --button="Retry:0" \
            2>/dev/null
        resp=$?
        case "$resp" in
            0) check_connectivity && return 0 ;;
            1)
                if command -v nm-connection-editor >/dev/null 2>&1; then
                    nm-connection-editor >/dev/null 2>&1 &
                elif command -v kitty >/dev/null 2>&1 && command -v nmtui >/dev/null 2>&1; then
                    kitty --title "Network settings" -e nmtui >/dev/null 2>&1
                else
                    yad --info --title="ShedOS Apps" --width=360 --center --button="OK!gtk-ok:0" \
                        --text="No network configuration tool found.\nInstall nm-connection-editor or run <tt>nmtui</tt> manually." \
                        2>/dev/null
                fi
                ;;
            *) return 1 ;;  # Skip / closed window
        esac
    done
}

if ! check_connectivity; then
    if ! prompt_connect; then
        # User chose to skip. No marker — we want them back here once
        # they're online. Welcome flow already moves on.
        exit 0
    fi
fi

# ---- Catalog → yad checklist ----------------------------------------------

# Load rows: aur_pkg | category | display_name | description | icon
declare -a AUR=() CAT=() NAME=() DESC=()
while IFS=$'\t' read -r pkg cat name desc _icon; do
    # Skip blanks + comments
    [[ -z "${pkg:-}" || "${pkg:0:1}" == "#" ]] && continue
    AUR+=("$pkg")
    CAT+=("$cat")
    NAME+=("$name")
    DESC+=("$desc")
done < "$CATALOG"

if [[ ${#AUR[@]} -eq 0 ]]; then
    yad --info --title="ShedOS Apps" --width=360 --center --button="OK!gtk-ok:0" \
        --text="No apps in the catalog. Nothing to do." 2>/dev/null
    touch "$MARKER"
    exit 0
fi

# Build yad --list args. Separator is ASCII Unit Separator so descriptions
# with spaces / punctuation round-trip cleanly.
SEP=$'\x1f'
LIST_ROWS=()
for i in "${!AUR[@]}"; do
    LIST_ROWS+=(
        "FALSE"
        "${CAT[$i]}"
        "${NAME[$i]}"
        "${DESC[$i]}"
        "${AUR[$i]}"
    )
done

SELECTION=$(yad --list --checklist \
    --title="ShedOS Apps" \
    --window-icon=system-software-install \
    --image=system-software-install \
    --text="<b>Install extra apps</b>\n\nThese are proprietary or vendor-hosted apps we can't ship by default.\nTick anything you want, then hit Install. You can re-open this picker any time from the launcher." \
    --width=760 --height=480 --center \
    --separator="$SEP" \
    --print-column=5 \
    --column="" \
    --column="Category" \
    --column="App" \
    --column="Description" \
    --column="AUR:HD" \
    "${LIST_ROWS[@]}" \
    --button="Skip:1" \
    --button="Install:0" \
    2>/dev/null)
LIST_CODE=$?

# Cancel / Skip — leave marker off so they can come back later.
if [[ $LIST_CODE -ne 0 ]]; then
    exit 0
fi

# yad --list --checklist with --print-column=N emits one checked row per
# line, with a trailing --separator char on each line. Strip the trailing
# separator and drop blanks.
PKGS=()
while IFS= read -r line; do
    line="${line%"$SEP"}"
    [[ -n "$line" ]] && PKGS+=("$line")
done <<< "$SELECTION"

if [[ ${#PKGS[@]} -eq 0 ]]; then
    # Nothing selected = user consciously skipped everything. Mark done
    # so we don't re-prompt on every login.
    touch "$MARKER"
    yad --info --title="ShedOS Apps" --width=360 --center --button="OK!gtk-ok:0" \
        --text="No apps selected. You can install anything later from the <b>ShedOS Apps</b> entry in your app launcher." \
        2>/dev/null
    exit 0
fi

# ---- Install with yay ------------------------------------------------------

# In dry-run we don't invoke yay at all — the UI, selection parsing, and
# final command string are what's under test; the package install is just
# yay doing yay things.
if [[ $DRY_RUN -eq 0 ]] && ! command -v yay >/dev/null 2>&1; then
    yad --error --title="ShedOS Apps" --width=400 --center --button="OK!gtk-ok:0" \
        --text="<b>yay is not installed.</b>\n\nInstall it with:\n<tt>sudo pacman -S yay</tt>\n\nThen re-run ShedOS Apps from the launcher." \
        2>/dev/null
    exit 1
fi

# Pick a terminal. kitty is the ShedOS default; fall back to the usual
# suspects so this still works on a customised desktop.
TERM_CMD=()
for t in kitty alacritty foot wezterm xterm; do
    if command -v "$t" >/dev/null 2>&1; then
        case "$t" in
            kitty)     TERM_CMD=("$t" --title "ShedOS Apps — Installing" -e) ;;
            alacritty) TERM_CMD=("$t" -t "ShedOS Apps — Installing" -e) ;;
            foot)      TERM_CMD=("$t" -T "ShedOS Apps — Installing") ;;
            wezterm)   TERM_CMD=("$t" start --) ;;
            xterm)     TERM_CMD=("$t" -title "ShedOS Apps — Installing" -e) ;;
        esac
        break
    fi
done

if [[ ${#TERM_CMD[@]} -eq 0 ]]; then
    yad --error --title="ShedOS Apps" --width=380 --center --button="OK!gtk-ok:0" \
        --text="No terminal emulator found. Install kitty, alacritty, foot, or xterm." \
        2>/dev/null
    exit 1
fi

STATUS_FILE=$(mktemp -t shedos-apps-XXXXXX.status)
trap 'rm -f "$STATUS_FILE"' EXIT

# `--needed` skips packages that are already installed, so re-runs are
# cheap. No --noconfirm: yay's own prompts (PKGBUILD review, sudo) are
# the user's to answer; silencing them would be rude on code that
# downloads and builds arbitrary vendor binaries.
if [[ $DRY_RUN -eq 1 ]]; then
    INSTALL_SCRIPT=$(cat <<EOS
echo
echo "DRY RUN — would execute:"
echo "    yay -S --needed ${PKGS[*]}"
echo
echo "0" > "$STATUS_FILE"
read -rp "Press Enter to close this window… " _
EOS
)
else
    INSTALL_SCRIPT=$(cat <<EOS
set -o pipefail
echo
echo "Installing: ${PKGS[*]}"
echo "---------------------------------------------"
yay -S --needed ${PKGS[*]}
rc=\$?
echo "---------------------------------------------"
echo "\$rc" > "$STATUS_FILE"
if [ "\$rc" -eq 0 ]; then
    echo
    echo "Done. You can close this window."
else
    echo
    echo "yay exited with status \$rc. Scroll up for details."
fi
read -rp "Press Enter to close this window… " _
EOS
)
fi

"${TERM_CMD[@]}" bash -c "$INSTALL_SCRIPT"

RC=1
[[ -r "$STATUS_FILE" ]] && RC=$(cat "$STATUS_FILE" 2>/dev/null || echo 1)

if [[ "$RC" == "0" ]]; then
    # Dry runs don't persist the marker — keeps the dev UI loop runnable
    # and leaves a real first-boot user's state untouched.
    [[ $DRY_RUN -eq 0 ]] && touch "$MARKER"
    yad --info --title="ShedOS Apps" --width=420 --center --button="OK!gtk-ok:0" \
        --window-icon=emblem-default \
        --image=emblem-default \
        --text="<b>Done!</b>\n\nInstalled: <tt>${PKGS[*]}</tt>\n\nLaunch them from your app launcher. You can add more any time via <b>ShedOS Apps</b>." \
        --button="Close:0" \
        2>/dev/null
    exit 0
else
    yad --warning --title="ShedOS Apps" --width=440 --center --button="OK!gtk-ok:0" \
        --text="<b>Some packages didn't install.</b>\n\nyay exited with status <tt>$RC</tt>. Try again after reading the terminal output — the usual culprits are missing PGP keys or expired AUR packages.\n\nRe-open this installer from your app launcher when you're ready." \
        2>/dev/null
    exit 1
fi

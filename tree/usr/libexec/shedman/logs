#!/usr/bin/env python3
"""shedman logs — two-pane journal browser TUI for ShedOS.

Left: list of loaded systemd units. Right: `journalctl -u <unit>` messages.
Bottom: a status bar that reflects the current filters (severity / time
window / regex) so the user never has to wonder "what am I looking at".

Keybindings (also visible in the footer + `?`):

    j / k           move unit cursor down / up (also ↓ / ↑)
    enter, space    load messages for the selected unit
    /               regex prompt (passed to `journalctl -g`)
    f               cycle severity floor (emerg → debug → all)
    t               cycle time window (1h / 6h / 24h / boot)
    s               toggle streaming mode (journalctl -f)
    c               copy the highlighted line to clipboard
    r               refresh unit list
    ?               show help
    q, ctrl+c       quit

Streaming is a blocking subprocess read, so it runs under Textual's
``@work(thread=True, exclusive=True)`` — exclusive means starting a new
stream cancels the previous one, which is exactly what we want when the
user jumps between units.

Tests drive the app via ``App.run_test()`` and control the subprocess
layer through two env-var hooks:

    SHEDOS_LOGS_UNITS_CMD    command whose stdout replaces
                             `systemctl list-units` (stubbable)
    SHEDOS_LOGS_JOURNAL_CMD  command template used instead of
                             `journalctl`; receives the same argv
                             (unit, since, priority, grep) via $@
"""

from __future__ import annotations

import argparse
import collections
import os
import re
import shlex
import shutil
import subprocess
import sys
from dataclasses import dataclass
from typing import Optional


# Small data helpers, kept importable without Textual so tests can exercise
# them cheaply and the main script degrades gracefully when textual is
# unavailable.


@dataclass
class Unit:
    name: str
    load: str
    active: str
    sub: str
    description: str


SEVERITY_LABELS = [
    ("emerg",   "0"),
    ("alert",   "0..1"),
    ("crit",    "0..2"),
    ("err",     "0..3"),
    ("warning", "0..4"),
    ("notice",  "0..5"),
    ("info",    "0..6"),
    ("debug",   "0..7"),
    ("all",     None),
]

TIME_WINDOWS = [
    ("1h",   "-1 hour ago"),
    ("6h",   "-6 hour ago"),
    ("24h",  "-1 day ago"),
    ("boot", None),  # passed as --boot instead of --since
]

# Cap the in-memory history so a chatty unit doesn't OOM the TUI.
RING_CAPACITY = 10_000


def parse_units(text: str) -> list[Unit]:
    """Parse `systemctl list-units --plain --no-legend` stdout.

    The default column layout is: UNIT LOAD ACTIVE SUB DESCRIPTION. We
    split on whitespace up to four times so the description (which often
    contains spaces) lands intact in the last field. Empty / malformed
    lines are skipped silently — systemctl occasionally emits footer
    chatter even with --no-legend, and we don't want one stray line to
    kill the table.
    """
    units: list[Unit] = []
    for raw in text.splitlines():
        line = raw.rstrip()
        if not line or line.startswith("●"):
            # "●" prefixes a failed-unit marker in some systemctl versions;
            # strip it off so name parses cleanly.
            line = line.lstrip("● \t")
            if not line:
                continue
        parts = line.split(None, 4)
        if len(parts) < 4:
            continue
        while len(parts) < 5:
            parts.append("")
        units.append(Unit(
            name=parts[0], load=parts[1], active=parts[2],
            sub=parts[3], description=parts[4],
        ))
    return units


def _run(cmd: list[str], env_override: Optional[str] = None) -> str:
    """Run a subprocess, return stdout text. Timeouts are bounded so a
    misbehaving journalctl can never freeze the UI; callers either get
    stdout or the empty string + an error shown in the pane.

    When ``env_override`` names an env var that's set, its value (shell-
    split) fully replaces ``cmd`` — tests typically point it at a
    ``cat /path/to/fixture`` so the rest of the code can run unchanged.
    """
    if env_override and os.environ.get(env_override):
        cmd = shlex.split(os.environ[env_override])
    try:
        out = subprocess.run(
            cmd, capture_output=True, text=True, timeout=10, check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        return f"(shedman logs: failed to run {cmd[0]}: {e})"
    if out.returncode != 0 and not out.stdout:
        return out.stderr.strip() or f"(shedman logs: {cmd[0]} exited {out.returncode})"
    return out.stdout


def list_units_raw() -> str:
    return _run(
        ["systemctl", "list-units", "--no-legend", "--no-pager", "--plain",
         "--all", "--state=loaded"],
        env_override="SHEDOS_LOGS_UNITS_CMD",
    )


def journal_snapshot(unit: str, *, severity: Optional[str],
                     since: Optional[str], grep: Optional[str],
                     lines: int = 1000) -> str:
    """Non-streaming journal fetch. Applies the current filters."""
    cmd = ["journalctl", "-u", unit, "--no-pager",
           "--output=short-iso-precise", "-n", str(lines)]
    if since is None:
        cmd.append("--boot")
    else:
        cmd.extend(["--since", since])
    if severity:
        cmd.extend(["-p", severity])
    if grep:
        cmd.extend(["-g", grep])
    return _run(cmd, env_override="SHEDOS_LOGS_JOURNAL_CMD")


def journal_stream_argv(unit: str, *, severity: Optional[str],
                        since: Optional[str],
                        grep: Optional[str]) -> list[str]:
    cmd = ["journalctl", "-u", unit, "-f",
           "--output=short-iso-precise", "-n", "200"]
    if since is None:
        cmd.append("--boot")
    else:
        cmd.extend(["--since", since])
    if severity:
        cmd.extend(["-p", severity])
    if grep:
        cmd.extend(["-g", grep])
    return cmd


def copy_to_clipboard(text: str) -> bool:
    """Best-effort clipboard copy. Returns True if one of the helpers ran
    successfully. The function is deliberately quiet on failure — the UI
    surfaces success/failure via a status line update so the user knows."""
    for tool in (["wl-copy"], ["xclip", "-selection", "clipboard"],
                 ["xsel", "--clipboard", "--input"]):
        if not shutil.which(tool[0]):
            continue
        try:
            p = subprocess.run(tool, input=text, text=True, timeout=3,
                               capture_output=True, check=False)
            if p.returncode == 0:
                return True
        except (OSError, subprocess.TimeoutExpired):
            continue
    return False


# Filter state, held as a tiny value type so the UI can print it verbatim
# and the tests can assert on it without booting Textual.


@dataclass
class FilterState:
    severity_idx: int = 8   # default "all"
    window_idx: int = 0     # default "1h"
    regex: Optional[str] = None

    @property
    def severity_label(self) -> str:
        return SEVERITY_LABELS[self.severity_idx][0]

    @property
    def severity_arg(self) -> Optional[str]:
        return SEVERITY_LABELS[self.severity_idx][1]

    @property
    def window_label(self) -> str:
        return TIME_WINDOWS[self.window_idx][0]

    @property
    def since_arg(self) -> Optional[str]:
        return TIME_WINDOWS[self.window_idx][1]

    def cycle_severity(self) -> None:
        self.severity_idx = (self.severity_idx + 1) % len(SEVERITY_LABELS)

    def cycle_window(self) -> None:
        self.window_idx = (self.window_idx + 1) % len(TIME_WINDOWS)

    def describe(self) -> str:
        regex = f"  regex={self.regex!r}" if self.regex else ""
        return (f"severity≤{self.severity_label}  "
                f"window={self.window_label}{regex}")


# Validation for the regex prompt. Tests cover this directly.


def validate_regex(pattern: str) -> Optional[str]:
    """Return None if the regex is valid, otherwise a short human reason."""
    if not pattern:
        return None
    try:
        re.compile(pattern)
    except re.error as e:
        return str(e)
    return None


# Textual UI, lazy-loaded so `--help` and unit tests can run without the dep.


LogsApp = None  # populated by build_app_class() — exposed so tests can pilot it.


def build_app_class():
    """Return the ``LogsApp`` class, importing Textual lazily. Cached on
    the module so repeated calls (e.g. per-test) share a single class."""
    global LogsApp
    if LogsApp is not None:
        return LogsApp
    try:
        from textual.app import App, ComposeResult
        from textual.binding import Binding
        from textual.containers import Horizontal, Vertical
        from textual.screen import ModalScreen
        from textual.widgets import (
            DataTable, Footer, Header, Input, Label, RichLog, Static,
        )
        from textual import work
    except Exception as e:
        raise RuntimeError(
            f"shedman logs: Textual not available ({e}). "
            f"Install python-textual."
        ) from e

    PALETTE = {
        "base": "#1e1e2e", "mantle": "#181825", "surface0": "#313244",
        "text": "#cdd6f4", "overlay0": "#6c7086",
        "green": "#a6e3a1", "red": "#f38ba8", "yellow": "#f9e2af",
        "blue": "#89b4fa", "mauve": "#cba6f7", "peach": "#fab387",
    }

    APP_CSS = """
    Screen { background: #1e1e2e; color: #cdd6f4; }
    Header { background: #181825; color: #89b4fa; }
    Footer { background: #181825; color: #6c7086; }

    #body { height: 1fr; }
    #units-pane {
        width: 40%; min-width: 32; max-width: 64;
        border: round #313244; padding: 0;
    }
    #units-pane.focus { border: round #89b4fa; }
    #messages-pane {
        width: 1fr; border: round #313244; padding: 0 1;
    }
    #messages-pane.focus { border: round #89b4fa; }

    DataTable { background: #1e1e2e; }
    DataTable > .datatable--header { background: #181825; color: #89b4fa; }
    DataTable > .datatable--cursor { background: #313244; color: #cdd6f4; }
    DataTable > .datatable--odd-row { background: #1e1e2e; }

    RichLog { background: #1e1e2e; color: #cdd6f4; scrollbar-color: #313244; }

    #filter-bar {
        dock: bottom; height: 1; background: #181825;
        color: #cdd6f4; padding: 0 1;
    }
    #status-line {
        dock: bottom; height: 1; background: #181825;
        color: #6c7086; padding: 0 1;
    }
    #status-line.ok { color: #a6e3a1; }
    #status-line.err { color: #f38ba8; }
    #status-line.stream { color: #fab387; }

    ModalScreen { align: center middle; }
    .dialog { border: thick #89b4fa; background: #181825; width: 60;
              height: auto; padding: 1 2; }
    .dialog-title { color: #89b4fa; text-style: bold; }
    .dialog-hint { color: #6c7086; }
    #help-box { width: 70; }
    """

    class HelpScreen(ModalScreen):
        BINDINGS = [Binding("escape,?,q", "app.pop_screen", "close")]

        HELP = """[b]shedman logs[/b]  keybindings

  [b]j / k[/b]        cursor down / up in unit list
  [b]enter[/b]       load messages for selected unit
  [b]/[/b]           regex prompt (journalctl -g)
  [b]f[/b]           cycle severity floor
  [b]t[/b]           cycle time window (1h / 6h / 24h / boot)
  [b]s[/b]           toggle streaming (follow)
  [b]c[/b]           copy highlighted line to clipboard
  [b]r[/b]           refresh unit list
  [b]tab[/b]         move focus between panes
  [b]?[/b]           this help
  [b]q[/b]           quit

[#6c7086]esc closes help.[/]
"""

        def compose(self) -> ComposeResult:
            with Vertical(classes="dialog", id="help-box"):
                yield Label(self.HELP)

    class RegexPromptScreen(ModalScreen):
        BINDINGS = [
            Binding("escape", "app.pop_screen", "cancel"),
        ]

        def __init__(self, initial: str = "") -> None:
            super().__init__()
            self._initial = initial

        def compose(self) -> ComposeResult:
            with Vertical(classes="dialog"):
                yield Label("Regex filter", classes="dialog-title")
                yield Input(value=self._initial, placeholder="empty = clear",
                            id="regex-input")
                yield Label("[enter] apply   [esc] cancel",
                            classes="dialog-hint")

        def on_input_submitted(self, event: Input.Submitted) -> None:
            self.dismiss(event.value)

    class _LogsApp(App):
        CSS = APP_CSS
        TITLE = "shedman logs"
        BINDINGS = [
            Binding("q", "quit", "quit"),
            Binding("ctrl+c", "quit", "quit", priority=True, show=False),
            Binding("question_mark", "help", "help"),
            Binding("r", "refresh_units", "refresh units"),
            Binding("slash", "regex", "regex"),
            Binding("f", "cycle_severity", "severity"),
            Binding("t", "cycle_window", "time"),
            Binding("s", "toggle_stream", "stream"),
            Binding("c", "copy_line", "copy"),
            Binding("tab", "focus_next", "focus", show=False),
        ]

        def __init__(self) -> None:
            super().__init__()
            self.filters = FilterState()
            self.selected_unit: Optional[str] = None
            self.streaming = False
            self._stream_proc: Optional[subprocess.Popen] = None
            self._ring: collections.deque[str] = collections.deque(
                maxlen=RING_CAPACITY)

        # -------- layout --------------------------------------------------

        def compose(self) -> ComposeResult:
            yield Header(show_clock=False)
            with Horizontal(id="body"):
                table = DataTable(id="units-pane", cursor_type="row",
                                  zebra_stripes=True)
                table.add_columns("unit", "active", "sub")
                yield table
                yield RichLog(id="messages-pane", highlight=True, markup=False,
                              wrap=False, auto_scroll=True, max_lines=RING_CAPACITY)
            yield Static("", id="filter-bar")
            yield Static("ready.", id="status-line")
            yield Footer()

        # -------- startup --------------------------------------------------

        def on_mount(self) -> None:
            self.query_one(DataTable).focus()
            self._refresh_filter_bar()
            self.action_refresh_units()

        # -------- actions --------------------------------------------------

        def action_help(self) -> None:
            self.push_screen(HelpScreen())

        def action_refresh_units(self) -> None:
            table = self.query_one(DataTable)
            table.clear()
            text = list_units_raw()
            units = parse_units(text)
            if not units:
                self._status(f"no units: {text.strip()[:120]}", kind="err")
                return
            for u in units:
                table.add_row(u.name, u.active, u.sub, key=u.name)
            # Preserve the previous selection if still present.
            if self.selected_unit:
                try:
                    table.move_cursor(row=table.get_row_index(self.selected_unit))
                except Exception:
                    pass
            self._status(f"{len(units)} units loaded.", kind="ok")

        def on_data_table_row_highlighted(self, event) -> None:
            if event.row_key is not None:
                self.selected_unit = str(event.row_key.value)

        def on_data_table_row_selected(self, event) -> None:
            if event.row_key is not None:
                self.selected_unit = str(event.row_key.value)
            self._load_messages()

        def action_regex(self) -> None:
            def after(value: Optional[str]) -> None:
                if value is None:
                    return
                value = value.strip() or None
                if value is not None:
                    reason = validate_regex(value)
                    if reason:
                        self._status(f"invalid regex: {reason}", kind="err")
                        return
                self.filters.regex = value
                self._refresh_filter_bar()
                self._load_messages()
            self.push_screen(
                RegexPromptScreen(initial=self.filters.regex or ""),
                after,
            )

        def action_cycle_severity(self) -> None:
            self.filters.cycle_severity()
            self._refresh_filter_bar()
            self._load_messages()

        def action_cycle_window(self) -> None:
            self.filters.cycle_window()
            self._refresh_filter_bar()
            self._load_messages()

        def action_toggle_stream(self) -> None:
            if self.streaming:
                self._stop_stream()
            else:
                self._start_stream()

        def action_copy_line(self) -> None:
            log = self.query_one(RichLog)
            # RichLog exposes rendered lines via `.lines`; each entry is a
            # Strip whose `.text` attr joins the segments. Copy the last
            # visible line as a pragmatic "copy current".
            if not log.lines:
                self._status("no line to copy.", kind="err")
                return
            try:
                text = log.lines[-1].text
            except Exception:
                text = ""
            if not text:
                self._status("empty line, nothing to copy.", kind="err")
                return
            ok = copy_to_clipboard(text)
            self._status("copied." if ok else "no clipboard helper found.",
                         kind="ok" if ok else "err")

        # -------- internal helpers ----------------------------------------

        def _refresh_filter_bar(self) -> None:
            bar = self.query_one("#filter-bar", Static)
            unit = self.selected_unit or "(no unit)"
            stream_tag = "  [STREAMING]" if self.streaming else ""
            bar.update(f"unit: {unit}  •  {self.filters.describe()}{stream_tag}")

        def _status(self, msg: str, *, kind: str = "ok") -> None:
            line = self.query_one("#status-line", Static)
            line.update(msg)
            for k in ("ok", "err", "stream"):
                line.remove_class(k)
            line.add_class(kind)

        def _load_messages(self) -> None:
            if self.streaming:
                self._stop_stream()
            if not self.selected_unit:
                return
            log = self.query_one(RichLog)
            log.clear()
            self._ring.clear()
            self._refresh_filter_bar()
            self._status(f"loading {self.selected_unit} …", kind="ok")
            self._fetch_snapshot(self.selected_unit,
                                 self.filters.severity_arg,
                                 self.filters.since_arg,
                                 self.filters.regex)

        @work(thread=True, exclusive=True, group="journal")
        def _fetch_snapshot(self, unit: str, severity: Optional[str],
                            since: Optional[str],
                            grep: Optional[str]) -> None:
            text = journal_snapshot(unit, severity=severity, since=since,
                                    grep=grep)
            self.call_from_thread(self._fill_from_text, unit, text)

        def _fill_from_text(self, unit: str, text: str) -> None:
            if unit != self.selected_unit:
                return  # user moved on; drop the result silently
            log = self.query_one(RichLog)
            lines = text.splitlines() or ["(no log entries match the filters)"]
            for line in lines:
                self._ring.append(line)
                log.write(line)
            self._status(f"{len(lines)} lines loaded.", kind="ok")

        def _start_stream(self) -> None:
            if not self.selected_unit:
                self._status("select a unit first.", kind="err")
                return
            argv = journal_stream_argv(
                self.selected_unit,
                severity=self.filters.severity_arg,
                since=self.filters.since_arg,
                grep=self.filters.regex,
            )
            # Honour the test hook here too so snapshot tests can stream
            # from a fake `journalctl`.
            override = os.environ.get("SHEDOS_LOGS_JOURNAL_CMD")
            if override:
                argv = shlex.split(override)
            try:
                proc = subprocess.Popen(
                    argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                    text=True, bufsize=1,
                )
            except OSError as e:
                self._status(f"stream failed: {e}", kind="err")
                return
            self._stream_proc = proc
            self.streaming = True
            self._refresh_filter_bar()
            self._status("streaming (press s to stop)", kind="stream")
            self._pump_stream(proc)

        @work(thread=True, exclusive=True, group="journal")
        def _pump_stream(self, proc: subprocess.Popen) -> None:
            assert proc.stdout is not None
            try:
                for raw in proc.stdout:
                    if proc is not self._stream_proc:
                        return
                    self.call_from_thread(self._append_stream_line,
                                          raw.rstrip("\n"))
            finally:
                if proc is self._stream_proc:
                    self.call_from_thread(self._finish_stream)

        def _append_stream_line(self, line: str) -> None:
            self._ring.append(line)
            self.query_one(RichLog).write(line)

        def _finish_stream(self) -> None:
            self.streaming = False
            self._stream_proc = None
            self._refresh_filter_bar()
            self._status("stream ended.", kind="ok")

        def _stop_stream(self) -> None:
            if self._stream_proc is not None:
                try:
                    self._stream_proc.terminate()
                except OSError:
                    pass
            self._stream_proc = None
            self.streaming = False
            self._refresh_filter_bar()
            self._status("stream stopped.", kind="ok")

        def action_quit(self) -> None:
            self._stop_stream()
            self.exit()

    LogsApp = _LogsApp
    globals()["LogsApp"] = _LogsApp
    return _LogsApp


def _run_app() -> int:
    try:
        cls = build_app_class()
    except RuntimeError as e:
        print(str(e), file=sys.stderr)
        return 2
    cls().run()
    return 0


# Entrypoint


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] == "--help-summary":
        print("two-pane journalctl browser TUI")
        return 0
    parser = argparse.ArgumentParser(
        prog="shedman logs",
        description="Two-pane journalctl browser TUI for ShedOS.",
    )
    parser.add_argument("--list-units", action="store_true",
                        help="Print the parsed unit list and exit. Useful "
                             "for smoke-testing the systemctl/env-hook path.")
    args = parser.parse_args()

    if args.list_units:
        units = parse_units(list_units_raw())
        for u in units:
            print(f"{u.name}\t{u.active}\t{u.sub}\t{u.description}")
        return 0

    if not sys.stdout.isatty():
        print("shedman logs: stdout is not a TTY — this is an interactive TUI.",
              file=sys.stderr)
        return 2

    return _run_app()


if __name__ == "__main__":
    raise SystemExit(main())

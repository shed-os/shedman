# Data types


class Side(str, enum.Enum):
    YOURS = "Y"
    THEIRS = "T"
    BOTH_YT = "BYT"
    BOTH_TY = "BTY"


@dataclass
class Hunk:
    index: int
    base_start: int
    base_end: int
    yours_start: int
    yours_end: int
    theirs_start: int
    theirs_end: int
    yours_lines: list[str] = field(default_factory=list)
    theirs_lines: list[str] = field(default_factory=list)
    base_lines: list[str] = field(default_factory=list)
    kind: str = "both-changed"
    decision: Optional[Side] = None


@dataclass
class Conflict:
    relpath: str
    pkg: str
    yours_path: Path
    theirs_path: Path
    src_path: Optional[Path]
    base_path: Optional[Path]
    kind: str        # "text" | "binary" | "orphan" | "symlink" | "missing-yours"
    has_base: bool
    size: int
    hunk_count: int = -1


@dataclass
class MergeState:
    relpath: str
    pkg: str
    yours_path: Path
    theirs_path: Path
    src_path: Optional[Path]
    base_path: Optional[Path]
    base_content: Optional[list[str]]
    yours_lines: list[str]
    theirs_lines: list[str]
    hunks: list[Hunk]
    encoding: str = "utf-8"
    newline: str = "\n"
    trailing_newline: bool = True
    yours_mode: int = 0o644
    yours_sha_at_load: str = ""
    theirs_sha_at_load: str = ""
    base_sha_at_load: str = ""
    src_sha_at_load: str = ""
    undo_stack: list[tuple[int, Optional[Side]]] = field(default_factory=list)

    @property
    def is_2way(self) -> bool:
        return self.base_content is None

    def unresolved_count(self) -> int:
        return sum(1 for h in self.hunks if h.decision is None)


class UnresolvedHunk(Exception):
    def __init__(self, hunk: Hunk) -> None:
        super().__init__(f"hunk {hunk.index} unresolved")
        self.hunk = hunk


# Low-level helpers


def _char_width(ch: str) -> int:
    """Monospace cell width of a single character.

    East Asian wide and full-width characters occupy 2 cells; combining
    marks and zero-width formatters occupy 0; everything else is 1.
    ``unicodedata.east_asian_width`` returns 'W'/'F' for 2-cell and
    'A' (ambiguous) for characters whose width is terminal-dependent —
    we conservatively treat 'A' as 1 cell because every common TUI
    terminal (kitty, foot, alacritty, xterm, tmux) does.
    """
    if not ch:
        return 0
    if unicodedata.category(ch) in ("Mn", "Me", "Cf"):
        return 0
    if unicodedata.east_asian_width(ch) in ("W", "F"):
        return 2
    return 1


def display_width(s: str) -> int:
    """Sum of ``_char_width`` across the string. Ignores Rich-markup tags."""
    # Strip Rich markup [foo] / [/foo] so the caller can pass already-styled
    # text without double-counting the markup as layout width.
    out = 0
    i = 0
    n = len(s)
    while i < n:
        ch = s[i]
        if ch == "[":
            end = s.find("]", i + 1)
            if end != -1:
                i = end + 1
                continue
        out += _char_width(ch)
        i += 1
    return out


def truncate_to_width(s: str, limit: int, ellipsis: str = "…") -> str:
    """Truncate ``s`` so its display width does not exceed ``limit``.

    Markup-aware: Rich markup tags don't count toward display width. The
    ellipsis is appended only when truncation actually occurs.
    """
    if limit <= 0:
        return ""
    if display_width(s) <= limit:
        return s
    budget = max(0, limit - _char_width(ellipsis[0]) if ellipsis else 0)
    out_chars: list[str] = []
    used = 0
    i = 0
    n = len(s)
    while i < n and used < budget:
        ch = s[i]
        if ch == "[":
            end = s.find("]", i + 1)
            if end != -1:
                out_chars.append(s[i:end + 1])
                i = end + 1
                continue
        w = _char_width(ch)
        if used + w > budget:
            break
        out_chars.append(ch)
        used += w
        i += 1
    return "".join(out_chars) + (ellipsis if ellipsis else "")


def _log(msg: str) -> None:
    try:
        LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
        with LOG_PATH.open("a") as f:
            f.write(f"{datetime.now(timezone.utc).isoformat()}  {msg}\n")
    except OSError:
        pass


def sha256_file(path: Path) -> str:
    try:
        h = hashlib.sha256()
        with path.open("rb") as f:
            for chunk in iter(lambda: f.read(1 << 16), b""):
                h.update(chunk)
        return h.hexdigest()
    except OSError:
        return ""


def sniff_binary(path: Path, sniff_bytes: int = BINARY_SNIFF_BYTES) -> bool:
    try:
        with path.open("rb") as f:
            chunk = f.read(sniff_bytes)
        return b"\x00" in chunk
    except OSError:
        return False


def is_oversized(path: Path) -> bool:
    # SequenceMatcher is O(n^2) worst-case; an oversized hunk extraction
    # would lock the TUI. Treat byte size as the cheap gate and only count
    # lines if the byte size is under the limit.
    try:
        size = path.stat().st_size
        if size > LARGE_FILE_BYTES:
            return True
        with path.open("rb") as f:
            lines = f.read().count(b"\n")
        return lines > LARGE_FILE_LINES
    except OSError:
        return False


def read_lines_any(path: Path) -> tuple[list[str], str, str, bool]:
    """Read a text file, returning (lines, encoding, newline, trailing_newline).

    Tries utf-8 then falls back to latin-1 (which never errors). Preserves
    whichever newline sequence is dominant in the file.
    """
    raw = path.read_bytes()
    encoding = "utf-8"
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        encoding = "latin-1"
        text = raw.decode("latin-1")
    # Detect newline: majority rule with LF as default.
    crlf = text.count("\r\n")
    lf = text.count("\n") - crlf
    newline = "\r\n" if crlf > lf else "\n"
    trailing_newline = text.endswith("\n") or text.endswith("\r\n")
    lines = text.splitlines()
    return lines, encoding, newline, trailing_newline


def write_lines_preserving(path: Path, lines: list[str], encoding: str,
                           newline: str, trailing_newline: bool, mode: int) -> None:
    body = newline.join(lines)
    if trailing_newline and not body.endswith(newline):
        body += newline
    data = body.encode(encoding, errors="replace")
    fd = os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
    try:
        os.write(fd, data)
        os.fsync(fd)
    finally:
        os.close(fd)


def atomic_rename(src: Path, dst: Path) -> None:
    os.rename(str(src), str(dst))
    try:
        fd = os.open(str(dst.parent), os.O_RDONLY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
    except OSError:
        pass


@dataclass(frozen=True)
class ExcludeConfig:
    patterns: tuple[re.Pattern[str], ...]
    skip_git_trees: bool


def _load_exclude_toml(path: Path) -> Optional[dict]:
    if not path.is_file():
        return None
    try:
        import tomllib
    except ImportError:
        sys.stderr.write(
            "shedman: warning: python tomllib unavailable; using built-in exclude defaults\n"
        )
        return None
    try:
        with open(path, "rb") as f:
            return tomllib.load(f)
    except (OSError, ValueError) as e:
        sys.stderr.write(
            f"shedman: warning: failed to parse {path}: {e}; falling back to defaults\n"
        )
        return None


def _coerce_patterns(raw, source: Path) -> list[str]:
    if raw is None:
        return []
    if not isinstance(raw, list) or not all(isinstance(p, str) for p in raw):
        sys.stderr.write(
            f"shedman: warning: {source}: 'patterns' must be a list of strings; ignoring it\n"
        )
        return []
    return list(raw)


def _build_exclude_config() -> ExcludeConfig:
    system = _load_exclude_toml(SYSTEM_EXCLUDE_PATH)
    user = _load_exclude_toml(USER_EXCLUDE_PATH)

    if system is None:
        raw_patterns: list[str] = list(DEFAULT_EXCLUDE_PATTERNS)
    else:
        raw_patterns = _coerce_patterns(system.get("patterns"), SYSTEM_EXCLUDE_PATH)
        if not raw_patterns:
            raw_patterns = list(DEFAULT_EXCLUDE_PATTERNS)

    if user is not None:
        raw_patterns.extend(_coerce_patterns(user.get("patterns"), USER_EXCLUDE_PATH))

    skip_git = DEFAULT_SKIP_GIT_TREES
    if system is not None and "skip_git_trees" in system:
        skip_git = bool(system["skip_git_trees"])
    if user is not None and "skip_git_trees" in user:
        skip_git = bool(user["skip_git_trees"])

    compiled: list[re.Pattern[str]] = []
    for p in raw_patterns:
        try:
            compiled.append(re.compile(p))
        except re.error as e:
            sys.stderr.write(
                f"shedman: warning: invalid exclude regex {p!r}: {e}; skipping it\n"
            )
    return ExcludeConfig(patterns=tuple(compiled), skip_git_trees=skip_git)


_EXCLUDE_CONFIG: Optional[ExcludeConfig] = None


def get_exclude_config() -> ExcludeConfig:
    global _EXCLUDE_CONFIG
    if _EXCLUDE_CONFIG is None:
        _EXCLUDE_CONFIG = _build_exclude_config()
    return _EXCLUDE_CONFIG


def is_excluded(relpath: str) -> bool:
    return any(r.search(relpath) for r in get_exclude_config().patterns)


def safe_relpath(relpath: str) -> str:
    # relpaths under $HOME are benign in practice; we mirror them verbatim.
    # Guard only against absolute paths and ".." segments.
    if relpath.startswith("/") or ".." in Path(relpath).parts:
        raise ValueError(f"unsafe relpath: {relpath!r}")
    return relpath


def manifest_path_for(relpath: str) -> Path:
    return MANIFEST_ROOT / f"{relpath}.sha256"


def base_content_path_for(relpath: str) -> Path:
    return CONTENT_ROOT / relpath


def draft_path_for(relpath: str) -> Path:
    return DRAFT_ROOT / f"{relpath}{DRAFT_SUFFIX}"


# Scan: discover .shedosnew conflicts under $HOME and classify each.


def find_pkg_and_src(relpath: str) -> tuple[Optional[str], Optional[Path]]:
    """Locate which shedos-* package owns this relpath.

    Returns (pkg_name, src_path) or (None, None) if no package ships a default
    at this relpath (orphan case).
    """
    if not DEFAULTS_ROOT.is_dir():
        return None, None
    for pkg_dir in sorted(DEFAULTS_ROOT.iterdir()):
        if not pkg_dir.is_dir():
            continue
        candidate = pkg_dir / "defaults" / relpath
        if candidate.is_file():
            return pkg_dir.name, candidate
    return None, None


def scan_conflicts() -> tuple[list[Conflict], list[str]]:
    """Walk $HOME for *.shedosnew files and classify each conflict.

    Returns (conflicts, excluded_relpaths). The second list is purely
    advisory — `.shedosnew` files that live under an excluded tree like
    ``.cache/`` or ``.local/state/`` are not actionable through the TUI,
    but the user deserves to know they exist so they can decide to
    delete them manually.
    """
    conflicts: list[Conflict] = []
    excluded: list[str] = []
    if not HOME.is_dir():
        return conflicts, excluded
    cfg = get_exclude_config()
    for dirpath, dirnames, filenames in os.walk(HOME, followlinks=False):
        rel_dir = os.path.relpath(dirpath, HOME)
        # Silently prune git working trees (other than $HOME itself, so
        # users tracking their dotfiles in a HOME-level repo still scan).
        if (
            cfg.skip_git_trees
            and rel_dir != "."
            and (".git" in dirnames or ".git" in filenames)
        ):
            dirnames[:] = []
            continue
        # Prune excluded trees early for speed, but first check if they
        # contain any .shedosnew files so we can surface them.
        if rel_dir != "." and is_excluded(rel_dir.replace(os.sep, "/") + "/"):
            for name in filenames:
                if name.endswith(NEW_SUFFIX):
                    yours = Path(dirpath) / name[: -len(NEW_SUFFIX)]
                    rel = os.path.relpath(yours, HOME).replace(os.sep, "/")
                    excluded.append(rel)
            dirnames[:] = []
            continue
        for name in filenames:
            if not name.endswith(NEW_SUFFIX):
                continue
            theirs = Path(dirpath) / name
            yours = theirs.with_name(name[: -len(NEW_SUFFIX)])
            rel = os.path.relpath(yours, HOME).replace(os.sep, "/")
            if is_excluded(rel):
                excluded.append(rel)
                continue
            conflicts.append(_classify(rel, yours, theirs))
    conflicts.sort(key=lambda c: c.relpath)
    excluded.sort()
    return conflicts, excluded


def _classify(relpath: str, yours: Path, theirs: Path) -> Conflict:
    pkg, src = find_pkg_and_src(relpath)
    base = base_content_path_for(relpath)
    has_base = base.is_file()
    size = 0
    try:
        size = theirs.stat().st_size
    except OSError:
        pass

    # symlink? Check YOURS first since we'd be writing to it.
    if yours.exists() and yours.is_symlink():
        kind = "symlink"
    elif not yours.exists():
        kind = "missing-yours"
    elif pkg is None or src is None:
        kind = "orphan"
    elif sniff_binary(theirs) or (yours.is_file() and sniff_binary(yours)):
        kind = "binary"
    elif (is_oversized(yours) or is_oversized(theirs)
          or (has_base and is_oversized(base))):
        kind = "oversized"
    else:
        kind = "text"

    return Conflict(
        relpath=relpath,
        pkg=pkg or "unknown",
        yours_path=yours,
        theirs_path=theirs,
        src_path=src,
        base_path=base if has_base else None,
        kind=kind,
        has_base=has_base,
        size=size,
    )


# Auto-resolve at scan: identical content (byte-for-byte) should just delete
# .shedosnew and bump the manifest. Never surfaced to the user.


def auto_resolve_identical(conflicts: list[Conflict]) -> tuple[list[Conflict], int]:
    """Return (remaining, auto_resolved_count)."""
    remaining: list[Conflict] = []
    auto_n = 0
    for c in conflicts:
        if c.kind != "text" or c.src_path is None:
            remaining.append(c)
            continue
        try:
            if sha256_file(c.yours_path) == sha256_file(c.theirs_path):
                # Identical: delete .shedosnew, update manifest to current src.
                c.theirs_path.unlink()
                _update_manifest(c.relpath, c.src_path)
                auto_n += 1
                continue
        except OSError:
            pass
        remaining.append(c)
    return remaining, auto_n


def _update_manifest(relpath: str, src_path: Path) -> None:
    # Each file written via tmp+rename so a crash leaves it fully old or
    # fully new. BASE before manifest so a partial update is recoverable
    # from the still-old manifest on the next sync.
    sha = sha256_file(src_path)
    if not sha:
        return

    bp = base_content_path_for(relpath)
    mp = manifest_path_for(relpath)
    bp.parent.mkdir(parents=True, exist_ok=True)
    mp.parent.mkdir(parents=True, exist_ok=True)
    pid = os.getpid()

    bp_tmp = bp.with_name(bp.name + TMP_SUFFIX + f".{pid}")
    if bp_tmp.exists():
        bp_tmp.unlink()
    shutil.copy2(src_path, bp_tmp)
    try:
        bp_tmp.chmod(0o600)
    except OSError:
        pass
    fd = os.open(str(bp_tmp), os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)
    atomic_rename(bp_tmp, bp)

    mp_tmp = mp.with_name(mp.name + TMP_SUFFIX + f".{pid}")
    if mp_tmp.exists():
        mp_tmp.unlink()
    fd = os.open(str(mp_tmp), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        os.write(fd, sha.encode("utf-8"))
        os.fsync(fd)
    finally:
        os.close(fd)
    atomic_rename(mp_tmp, mp)


# Hunk extraction (3-way + 2-way)


def extract_hunks_3way(base: list[str], yours: list[str],
                       theirs: list[str]) -> list[Hunk]:
    """diff3-style hunk extraction.

    Walk base positions once, using SequenceMatcher opcodes (base↔yours)
    and (base↔theirs) in lockstep. Emit a hunk for every base range that
    YOURS or THEIRS touched. Context ranges (neither changed) are dropped.
    """
    ops_y = SequenceMatcher(a=base, b=yours, autojunk=False).get_opcodes()
    ops_t = SequenceMatcher(a=base, b=theirs, autojunk=False).get_opcodes()

    # Build per-base-line annotations: for each base index, the corresponding
    # yours / theirs ranges if "equal", or None if modified.
    # Then coalesce runs.
    # Materialise an event list: (base_idx, 'y'|'t', 'equal'|'change', (other_lo, other_hi))
    # Simpler: build two arrays y_map and t_map each of length len(base)+1
    #   y_map[i] = 'equal' -> yours idx, else None meaning modified
    # and also track the changed regions explicitly as list of (base_lo, base_hi, yours_lo, yours_hi).

    y_changes = _change_regions(ops_y)
    t_changes = _change_regions(ops_t)

    # Merge change regions by base range. Any overlap in base range means a
    # "both-changed" hunk; non-overlapping produce their own hunks.
    merged = _merge_change_regions(y_changes, t_changes, len(base), len(yours), len(theirs))

    hunks: list[Hunk] = []
    for idx, region in enumerate(merged):
        bs, be, ys, ye, ts, te, kind = region
        h = Hunk(
            index=idx,
            base_start=bs, base_end=be,
            yours_start=ys, yours_end=ye,
            theirs_start=ts, theirs_end=te,
            yours_lines=yours[ys:ye],
            theirs_lines=theirs[ts:te],
            base_lines=base[bs:be],
            kind=kind,
        )
        # Pre-mark sensible defaults.
        if kind == "yours-only":
            h.decision = Side.YOURS
        elif kind == "theirs-only":
            h.decision = Side.THEIRS
        elif kind == "both-changed" and h.yours_lines == h.theirs_lines:
            # Identical edit on both sides; either pick yields the same output.
            h.decision = Side.YOURS
        hunks.append(h)
    return hunks


def _change_regions(opcodes) -> list[tuple[int, int, int, int]]:
    """Return non-equal opcode regions as (a_lo, a_hi, b_lo, b_hi)."""
    out = []
    for tag, a_lo, a_hi, b_lo, b_hi in opcodes:
        if tag != "equal":
            out.append((a_lo, a_hi, b_lo, b_hi))
    return out


def _merge_change_regions(y_changes, t_changes, n_base, n_yours, n_theirs):
    """Merge YOURS and THEIRS change regions over BASE into unified hunks.

    Returns a list of (base_start, base_end, yours_start, yours_end,
                       theirs_start, theirs_end, kind).
    kind ∈ {'yours-only', 'theirs-only', 'both-changed'}.
    """
    # Sort and walk; coalesce overlapping or touching regions.
    y_idx = 0
    t_idx = 0
    merged = []
    while y_idx < len(y_changes) or t_idx < len(t_changes):
        y = y_changes[y_idx] if y_idx < len(y_changes) else None
        t = t_changes[t_idx] if t_idx < len(t_changes) else None
        if y is None:
            merged.append(("t", t)); t_idx += 1; continue
        if t is None:
            merged.append(("y", y)); y_idx += 1; continue
        if y[1] <= t[0]:
            merged.append(("y", y)); y_idx += 1
        elif t[1] <= y[0]:
            merged.append(("t", t)); t_idx += 1
        else:
            # Overlap: coalesce into a both-changed block. Extend as needed
            # by sweeping forward until the combined base range no longer
            # overlaps the next region from either side.
            bs = min(y[0], t[0])
            be = max(y[1], t[1])
            ys_lo, ys_hi = y[2], y[3]
            ts_lo, ts_hi = t[2], t[3]
            y_idx += 1; t_idx += 1
            changed = True
            while changed:
                changed = False
                if y_idx < len(y_changes) and y_changes[y_idx][0] < be:
                    yy = y_changes[y_idx]
                    be = max(be, yy[1])
                    ys_hi = max(ys_hi, yy[3]); ys_lo = min(ys_lo, yy[2])
                    y_idx += 1; changed = True
                if t_idx < len(t_changes) and t_changes[t_idx][0] < be:
                    tt = t_changes[t_idx]
                    be = max(be, tt[1])
                    ts_hi = max(ts_hi, tt[3]); ts_lo = min(ts_lo, tt[2])
                    t_idx += 1; changed = True
            merged.append(("both", (bs, be, ys_lo, ys_hi, ts_lo, ts_hi)))

    # Now convert tagged entries to canonical tuples with full (ys, ye, ts, te).
    # For "yours-only" entries we must compute the THEIRS projection of the
    # base range (which is "equal" in THEIRS, so theirs_start/end track base
    # positions offset by any earlier edits). Similarly for "theirs-only".
    # We compute this by doing a cumulative-offset pass over the opcodes.
    # Simpler approach: re-run SequenceMatcher to get offsets, but for our
    # purposes the "equal" projection can be derived from opcodes directly.

    out = []
    for tag, reg in merged:
        if tag == "y":
            a_lo, a_hi, b_lo, b_hi = reg
            # THEIRS is unchanged across this base range; project base→theirs
            # by identity offset from the t_changes we've already walked.
            ts_lo = _project_base_to_side(a_lo, t_changes, n_base, n_theirs)
            ts_hi = _project_base_to_side(a_hi, t_changes, n_base, n_theirs)
            out.append((a_lo, a_hi, b_lo, b_hi, ts_lo, ts_hi, "yours-only"))
        elif tag == "t":
            a_lo, a_hi, b_lo, b_hi = reg
            ys_lo = _project_base_to_side(a_lo, y_changes, n_base, n_yours)
            ys_hi = _project_base_to_side(a_hi, y_changes, n_base, n_yours)
            out.append((a_lo, a_hi, ys_lo, ys_hi, b_lo, b_hi, "theirs-only"))
        else:
            bs, be, ys_lo, ys_hi, ts_lo, ts_hi = reg
            out.append((bs, be, ys_lo, ys_hi, ts_lo, ts_hi, "both-changed"))
    return out


def _project_base_to_side(base_pos: int, side_changes, n_base: int, n_side: int) -> int:
    """Given a base index, compute the corresponding SIDE index.

    side_changes are the non-equal regions in (base, side). Anywhere outside
    those regions is an 'equal' stretch whose offset is the running delta of
    (side_hi - base_hi) through the preceding regions.
    """
    offset = 0
    for a_lo, a_hi, b_lo, b_hi in side_changes:
        if base_pos <= a_lo:
            break
        if base_pos >= a_hi:
            offset += (b_hi - b_lo) - (a_hi - a_lo)
        else:
            # base_pos falls inside a changed region; snap to b_lo.
            return b_lo
    return base_pos + offset


# Word-level diff: tokenize, run a token-level SequenceMatcher, emit spans.
# Used by the TUI to highlight changed words within a paired add/del line so
# the reader can see precisely what changed, not just "the whole line is red."

_WORD_TOKEN_RE = re.compile(r'(\w+|\s+|[^\w\s])')


def diff_words(old: str, new: str
               ) -> tuple[list[tuple[str, str]], list[tuple[str, str]]]:
    """Return (old_spans, new_spans). Each span is (kind, text):
    kind="equal" — unchanged on both sides
    kind="removed" — present in old but not new (only on old_spans)
    kind="added"   — present in new but not old (only on new_spans)
    """
    old_tokens = _WORD_TOKEN_RE.findall(old)
    new_tokens = _WORD_TOKEN_RE.findall(new)
    sm = SequenceMatcher(a=old_tokens, b=new_tokens, autojunk=False)
    old_spans: list[tuple[str, str]] = []
    new_spans: list[tuple[str, str]] = []
    for op, i1, i2, j1, j2 in sm.get_opcodes():
        old_text = "".join(old_tokens[i1:i2])
        new_text = "".join(new_tokens[j1:j2])
        if op == "equal":
            if old_text:
                old_spans.append(("equal", old_text))
            if new_text:
                new_spans.append(("equal", new_text))
        elif op == "delete":
            if old_text:
                old_spans.append(("removed", old_text))
        elif op == "insert":
            if new_text:
                new_spans.append(("added", new_text))
        elif op == "replace":
            if old_text:
                old_spans.append(("removed", old_text))
            if new_text:
                new_spans.append(("added", new_text))
    return old_spans, new_spans


class ShedConfLexer(RegexLexer):
    """Minimal lexer for Hyprland-style .conf files."""

    name = "ShedConf"
    aliases = ["shed-conf", "hypr-conf"]
    filenames = ["*.conf"]

    tokens = {
        "root": [
            (r"#.*$", Comment.Single),
            (r"\$\w+", Name.Variable),
            (words(("true", "false"), suffix=r"\b"), Keyword.Constant),
            (r"\b(exec|dispatcher|source|bind\w*|unbind|gesture|monitor|"
             r"workspace|windowrulev2|windowrule|layerrule|plugin)\b",
             Name.Builtin),
            (r"\b(rgba?|hsla?)\b", Name.Function),
            (r"-?\d+\.\d+", Number.Float),
            (r"-?\d+", Number.Integer),
            (r'"[^"\n]*"', String.Double),
            (r"'[^'\n]*'", String.Single),
            (r"\b\w+(?=\s*\{)", Name.Class),  # section heads before {
            (r"\b\w+(?=\s*=)", Name.Attribute),  # keys before =
            (r"[{}]", Punctuation),
            (r"=", Operator),
            (r",", Punctuation),
            (r"\s+", Whitespace),
            (r"\w+", Name),
            (r".", TextToken),
        ],
    }


_LEXER_BY_SUFFIX: dict[str, type] = {
    ".lua": LuaLexer,
    # Pygments has no dedicated zsh lexer; bash is the closest superset.
    ".zsh": BashLexer,
    ".zshrc": BashLexer,
    ".zprofile": BashLexer,
    ".zlogin": BashLexer,
    ".toml": TOMLLexer,
    ".ini": IniLexer,
    ".css": CssLexer,
    ".sh": BashLexer,
    ".bash": BashLexer,
    ".bashrc": BashLexer,
    ".py": PythonLexer,
    ".yaml": YamlLexer,
    ".yml": YamlLexer,
    ".json": JsonLexer,
    ".conf": ShedConfLexer,
}

_LEXER_BY_FILENAME: dict[str, type] = {
    ".bashrc": BashLexer,
    ".zshrc": BashLexer,
    ".zprofile": BashLexer,
    ".zlogin": BashLexer,
    ".profile": BashLexer,
}


def _lexer_for(relpath: str):
    """Return a Pygments lexer for the file, or None if the type is unknown."""
    name = Path(relpath).name.lower()
    if name in _LEXER_BY_FILENAME:
        return _LEXER_BY_FILENAME[name]()
    if name.startswith("p10k") or name.endswith(".zsh"):
        return BashLexer()
    cls = _LEXER_BY_SUFFIX.get(Path(relpath).suffix.lower())
    return cls() if cls is not None else None


# Most-specific token class first; first parent match wins.
_TOKEN_PALETTE: list[tuple[object, str]] = [
    (Comment, "overlay0"),
    (Keyword.Constant, "yellow"),
    (Keyword, "mauve"),
    (Name.Builtin, "red"),
    (Name.Function, "blue"),
    (Name.Attribute, "blue"),
    (Name.Variable, "mauve"),
    (Name.Class, "yellow"),
    (String, "green"),
    (Number, "yellow"),
    (Operator, "text"),
    (Punctuation, "overlay0"),
]


def _token_to_palette_key(tok) -> str:
    for parent, key in _TOKEN_PALETTE:
        if tok in parent:
            return key
    return "text"


def syntax_spans(text: str, lexer) -> list[tuple[str, str]]:
    """Tokenise text and return list of (palette_key, span_text)."""
    spans: list[tuple[str, str]] = []
    for tok, span_text in pygments_lex(text, lexer):
        if not span_text:
            continue
        spans.append((_token_to_palette_key(tok), span_text))
    return spans


def extract_hunks_2way(yours: list[str], theirs: list[str]) -> list[Hunk]:
    ops = SequenceMatcher(a=yours, b=theirs, autojunk=False).get_opcodes()
    hunks: list[Hunk] = []
    idx = 0
    for tag, y_lo, y_hi, t_lo, t_hi in ops:
        if tag == "equal":
            continue
        hunks.append(Hunk(
            index=idx,
            base_start=-1, base_end=-1,
            yours_start=y_lo, yours_end=y_hi,
            theirs_start=t_lo, theirs_end=t_hi,
            yours_lines=yours[y_lo:y_hi],
            theirs_lines=theirs[t_lo:t_hi],
            base_lines=[],
            kind="both-changed",
            decision=None,
        ))
        idx += 1
    return hunks


# Assembly


def assemble(state: MergeState) -> list[str]:
    if state.base_content is None:
        return _assemble_2way(state)
    return _assemble_3way(state)


def _apply_decision(out: list[str], h: Hunk) -> None:
    dec = h.decision
    if dec == Side.YOURS:
        out.extend(h.yours_lines)
    elif dec == Side.THEIRS:
        out.extend(h.theirs_lines)
    elif dec == Side.BOTH_YT:
        out.extend(h.yours_lines); out.extend(h.theirs_lines)
    elif dec == Side.BOTH_TY:
        out.extend(h.theirs_lines); out.extend(h.yours_lines)
    else:
        raise UnresolvedHunk(h)


def _assemble_3way(state: MergeState) -> list[str]:
    assert state.base_content is not None
    out: list[str] = []
    cursor = 0
    for h in state.hunks:
        out.extend(state.base_content[cursor:h.base_start])
        _apply_decision(out, h)
        cursor = h.base_end
    out.extend(state.base_content[cursor:])
    return out


def _assemble_2way(state: MergeState) -> list[str]:
    # Walk YOURS; hunks appear in yours-space order from extract_hunks_2way.
    out: list[str] = []
    cursor = 0
    for h in state.hunks:
        out.extend(state.yours_lines[cursor:h.yours_start])
        _apply_decision(out, h)
        cursor = h.yours_end
    out.extend(state.yours_lines[cursor:])
    return out


# Aligned-row model for the 3-pane merge viewer.
#
# The merge UI shows YOURS | BASE | THEIRS as three parallel columns with the
# lines lined up: context regions occupy the same visual row in all three
# panes, and a hunk region is padded with blank cells on the shorter sides so
# the three pane heights stay equal. This is the data model IntelliJ's merge
# viewer shows; we need the alignment here so vertical scroll stays in sync
# without the reader having to cross-reference line numbers.


@dataclass
class Cell:
    # lineno is 1-based; None for padding rows inside a hunk.
    lineno: Optional[int]
    text: Optional[str]
    # Per-cell diff classification vs BASE (in 3-way) or vs the counterpart
    # side (in 2-way). Renderer turns this into a unified-diff marker + color:
    #   "equal"   → neutral, no marker  (line unchanged from BASE)
    #   "add"     → green "+"           (line the side introduced)
    #   "del"     → red "-"             (line the side deleted from BASE;
    #                                    cell.text holds the deleted content)
    #   "ctx"     → neutral, no marker  (context row outside any hunk)
    tag: str = "ctx"
    # Optional word-level spans for paired add/del rows where both sides
    # modified the same base line. When set, the renderer walks the spans
    # and emphasises changed runs ("removed" / "added") instead of styling
    # the whole text with one colour. None when no pairing was found.
    spans: Optional[list[tuple[str, str]]] = None
    # Syntax-highlight spans (palette_key, text); rendered when `spans`
    # is None and the file's language is recognised.
    syntax: Optional[list[tuple[str, str]]] = None


@dataclass
class AlignedRow:
    yours: Cell
    base: Cell
    theirs: Cell
    # None for context rows, otherwise the hunk index this row is part of.
    hunk_index: Optional[int]

    @property
    def is_hunk(self) -> bool:
        return self.hunk_index is not None


def _align_pair_vs_base(base: list[str], side: list[str]
                        ) -> tuple[list[tuple[str, Optional[int]]],
                                   list[list[int]]]:
    """Pairwise-align one side (YOURS or THEIRS) against BASE.

    Returns a pair ``(at, inserts_before)`` where:

    - ``at`` has length ``len(base)``. Each entry is ``(tag, side_idx)`` where
      tag is ``"equal"`` (side has this base line unchanged, side_idx is the
      matching index into ``side``) or ``"del"`` (side deleted this base
      line; side_idx is None).
    - ``inserts_before`` has length ``len(base) + 1``. Entry ``k`` is a list
      of ``side`` indices that the side inserted anchored just before
      ``base[k]`` (or at end-of-file when k == len(base)).

    "Replace" opcodes are decomposed into the base-range becoming ``"del"``
    plus the side-range becoming inserts anchored at the start of the
    replaced base range — that way the pane can render each changed line as
    a distinct green "+" or red "-" in the git-diff tradition.
    """
    at: list[tuple[str, Optional[int]]] = [("del", None)] * len(base)
    inserts_before: list[list[int]] = [[] for _ in range(len(base) + 1)]
    sm = SequenceMatcher(None, base, side, autojunk=False)
    for op, b1, b2, s1, s2 in sm.get_opcodes():
        if op == "equal":
            for k in range(b2 - b1):
                at[b1 + k] = ("equal", s1 + k)
        elif op == "delete":
            for k in range(b2 - b1):
                at[b1 + k] = ("del", None)
        elif op == "insert":
            for k in range(s2 - s1):
                inserts_before[b1].append(s1 + k)
        elif op == "replace":
            for k in range(b2 - b1):
                at[b1 + k] = ("del", None)
            for k in range(s2 - s1):
                inserts_before[b1].append(s1 + k)
    return at, inserts_before


def _hunk_rows_3way(hunk, state_hunk_index: int) -> list[AlignedRow]:
    """Emit aligned rows for one 3-way hunk.

    The algorithm walks BASE linearly. At each base position it first drains
    any inserts (anchored just before that base line) from YOURS and THEIRS,
    pairing them visually row-by-row. Then it emits the row for ``base[b]``
    itself: each side's cell is either the kept YOURS/THEIRS line ("equal")
    or a red "-" showing the deleted base content ("del"). Pure inserts get
    a tilde placeholder in the BASE pane so the three columns stay aligned.
    """
    base = hunk.base_lines
    yours = hunk.yours_lines
    theirs = hunk.theirs_lines
    y_base_ln_start = hunk.yours_start + 1
    b_base_ln_start = hunk.base_start + 1
    t_base_ln_start = hunk.theirs_start + 1

    y_at, y_ins = _align_pair_vs_base(base, yours)
    t_at, t_ins = _align_pair_vs_base(base, theirs)

    rows: list[AlignedRow] = []
    for b in range(len(base) + 1):
        # Drain inserts anchored before base[b]. Pair yours vs theirs
        # row-by-row and pad the shorter side with a blank cell so both
        # panes scroll in sync.
        y_list = y_ins[b]
        t_list = t_ins[b]
        for k in range(max(len(y_list), len(t_list))):
            y_text = yours[y_list[k]] if k < len(y_list) else None
            t_text = theirs[t_list[k]] if k < len(t_list) else None
            # When both sides insert at the same anchor and the texts
            # differ but are short enough, compute word-level spans so the
            # renderer can highlight exactly the changed runs.
            y_spans = t_spans = None
            if (y_text is not None and t_text is not None
                    and y_text != t_text
                    and len(y_text) <= LONG_LINE_HL_CUTOFF
                    and len(t_text) <= LONG_LINE_HL_CUTOFF):
                y_spans, t_spans = diff_words(y_text, t_text)
            if y_text is not None:
                y_cell = Cell(y_base_ln_start + y_list[k], y_text,
                              tag="add", spans=y_spans)
            else:
                y_cell = Cell(None, None, tag="equal")
            if t_text is not None:
                t_cell = Cell(t_base_ln_start + t_list[k], t_text,
                              tag="add", spans=t_spans)
            else:
                t_cell = Cell(None, None, tag="equal")
            rows.append(AlignedRow(
                yours=y_cell,
                base=Cell(None, None, tag="equal"),
                theirs=t_cell,
                hunk_index=state_hunk_index,
            ))

        if b >= len(base):
            break

        # Emit the row anchored on base[b].
        y_tag, y_idx = y_at[b]
        t_tag, t_idx = t_at[b]
        if y_tag == "equal":
            y_cell = Cell(y_base_ln_start + y_idx,
                          yours[y_idx], tag="equal")
        else:
            # yours removed base[b]: show base content in red "-" column.
            y_cell = Cell(None, base[b], tag="del")
        if t_tag == "equal":
            t_cell = Cell(t_base_ln_start + t_idx,
                          theirs[t_idx], tag="equal")
        else:
            t_cell = Cell(None, base[b], tag="del")
        b_cell = Cell(b_base_ln_start + b, base[b], tag="equal")
        rows.append(AlignedRow(
            yours=y_cell, base=b_cell, theirs=t_cell,
            hunk_index=state_hunk_index,
        ))
    return rows


def _hunk_rows_2way(hunk, state_hunk_index: int) -> list[AlignedRow]:
    """Emit aligned rows for one 2-way hunk (no BASE available).

    Uses the same pairwise alignment against YOURS as the implicit base, so
    "add" rows are lines THEIRS introduced (green "+") and "del" rows are
    lines THEIRS removed from YOURS (red "-"). YOURS is neutral equal except
    where the counterpart side marks a row as removed.
    """
    yours = hunk.yours_lines
    theirs = hunk.theirs_lines
    y_base_ln_start = hunk.yours_start + 1
    t_base_ln_start = hunk.theirs_start + 1

    # In 2-way we pretend YOURS is the baseline and align THEIRS against it.
    t_at, t_ins = _align_pair_vs_base(yours, theirs)

    rows: list[AlignedRow] = []
    for y in range(len(yours) + 1):
        t_list = t_ins[y]
        for k in range(len(t_list)):
            t_i = t_list[k]
            rows.append(AlignedRow(
                yours=Cell(None, None, tag="equal"),
                base=Cell(None, None, tag="equal"),
                theirs=Cell(t_base_ln_start + t_i,
                            theirs[t_i], tag="add"),
                hunk_index=state_hunk_index,
            ))
        if y >= len(yours):
            break
        t_tag, t_idx = t_at[y]
        if t_tag == "equal":
            # YOURS line kept in THEIRS too: both neutral, no marker.
            y_cell = Cell(y_base_ln_start + y, yours[y], tag="equal")
            t_cell = Cell(t_base_ln_start + t_idx,
                          theirs[t_idx], tag="equal")
        else:
            # THEIRS deleted this YOURS line: show it red on the THEIRS side.
            y_cell = Cell(y_base_ln_start + y, yours[y], tag="equal")
            t_cell = Cell(None, yours[y], tag="del")
        rows.append(AlignedRow(
            yours=y_cell,
            base=Cell(None, None, tag="equal"),
            theirs=t_cell,
            hunk_index=state_hunk_index,
        ))
    return rows


def build_aligned_rows(state: MergeState) -> list[AlignedRow]:
    """Produce per-row triples that align YOURS/BASE/THEIRS in the viewport.

    For a 3-way merge, equal regions sit at the same (base) line position in
    all three files, so they emit one row per equal line. Inside a hunk we
    do proper per-side alignment against BASE (see ``_hunk_rows_3way``):
    each row's YOURS/THEIRS cell is tagged ``equal``/``add``/``del`` so the
    renderer can draw a green "+" or red "-" per line while the BASE
    pane stays neutral.

    For a 2-way merge (no BASE), the BASE cell is always blank and we align
    THEIRS against YOURS inside each hunk the same way.
    """
    rows: list[AlignedRow] = []
    yours = state.yours_lines
    theirs = state.theirs_lines

    if state.base_content is not None:
        base = state.base_content
        cb = cy = ct = 0
        for i, h in enumerate(state.hunks):
            # Context preceding the hunk: equal across all three files.
            n_ctx = h.base_start - cb
            for j in range(n_ctx):
                rows.append(AlignedRow(
                    yours=Cell(cy + j + 1, yours[cy + j], tag="ctx"),
                    base=Cell(cb + j + 1, base[cb + j], tag="ctx"),
                    theirs=Cell(ct + j + 1, theirs[ct + j], tag="ctx"),
                    hunk_index=None,
                ))
            cb, cy, ct = h.base_start, h.yours_start, h.theirs_start
            rows.extend(_hunk_rows_3way(h, i))
            cb, cy, ct = h.base_end, h.yours_end, h.theirs_end

        # Trailing context.
        while cb < len(base):
            rows.append(AlignedRow(
                yours=Cell(cy + 1, yours[cy], tag="ctx")
                      if cy < len(yours) else Cell(None, None, tag="ctx"),
                base=Cell(cb + 1, base[cb], tag="ctx"),
                theirs=Cell(ct + 1, theirs[ct], tag="ctx")
                       if ct < len(theirs) else Cell(None, None, tag="ctx"),
                hunk_index=None,
            ))
            cb += 1; cy += 1; ct += 1
        return rows

    # 2-way.
    cy = ct = 0
    for i, h in enumerate(state.hunks):
        n_ctx = h.yours_start - cy
        for j in range(n_ctx):
            rows.append(AlignedRow(
                yours=Cell(cy + j + 1, yours[cy + j], tag="ctx"),
                base=Cell(None, None, tag="ctx"),
                theirs=Cell(ct + j + 1, theirs[ct + j], tag="ctx")
                       if ct + j < len(theirs) else Cell(None, None, tag="ctx"),
                hunk_index=None,
            ))
        cy, ct = h.yours_start, h.theirs_start
        rows.extend(_hunk_rows_2way(h, i))
        cy, ct = h.yours_end, h.theirs_end
    while cy < len(yours):
        rows.append(AlignedRow(
            yours=Cell(cy + 1, yours[cy], tag="ctx"),
            base=Cell(None, None, tag="ctx"),
            theirs=Cell(ct + 1, theirs[ct], tag="ctx")
                   if ct < len(theirs) else Cell(None, None, tag="ctx"),
            hunk_index=None,
        ))
        cy += 1; ct += 1

    # Only highlight equal/ctx cells: add/del keep their red/green so the
    # change signal isn't lost under token colouring.
    lexer = _lexer_for(state.relpath)
    if lexer is not None:
        for row in rows:
            for cell in (row.yours, row.base, row.theirs):
                if (cell.text is not None
                        and cell.spans is None
                        and cell.tag in ("equal", "ctx")):
                    cell.syntax = syntax_spans(cell.text, lexer)
    return rows


# Load a merge state for one conflict.


def load_merge_state(c: Conflict, force_2way: bool = False) -> MergeState:
    yours_lines, encoding, newline, trailing_newline = read_lines_any(c.yours_path)
    theirs_lines, t_enc, t_nl, t_tn = read_lines_any(c.theirs_path)
    # Encoding disagreement is rare; prefer YOURS.
    base_content: Optional[list[str]] = None
    base_sha = ""
    if not force_2way and c.base_path is not None and c.base_path.is_file():
        try:
            bl, _, _, _ = read_lines_any(c.base_path)
            base_content = bl
            base_sha = sha256_file(c.base_path)
        except OSError as e:
            _log(f"base unreadable for {c.relpath}: {e}")

    if base_content is not None:
        hunks = extract_hunks_3way(base_content, yours_lines, theirs_lines)
    else:
        hunks = extract_hunks_2way(yours_lines, theirs_lines)

    yours_mode = 0o644
    try:
        yours_mode = _stat.S_IMODE(c.yours_path.lstat().st_mode)
    except OSError:
        pass

    return MergeState(
        relpath=c.relpath,
        pkg=c.pkg,
        yours_path=c.yours_path,
        theirs_path=c.theirs_path,
        src_path=c.src_path,
        base_path=c.base_path,
        base_content=base_content,
        yours_lines=yours_lines,
        theirs_lines=theirs_lines,
        hunks=hunks,
        encoding=encoding,
        newline=newline,
        trailing_newline=trailing_newline,
        yours_mode=yours_mode,
        yours_sha_at_load=sha256_file(c.yours_path),
        theirs_sha_at_load=sha256_file(c.theirs_path),
        base_sha_at_load=base_sha,
        src_sha_at_load=sha256_file(c.src_path) if c.src_path else "",
    )


# Atomic write-back


class ConcurrentModification(Exception):
    def __init__(self, which: str) -> None:
        super().__init__(f"{which} changed on disk since load")
        self.which = which


def save_merged(state: MergeState, force: bool = False) -> None:
    # 1. Re-hash YOURS and THEIRS.
    if not force:
        cur_yours = sha256_file(state.yours_path)
        if cur_yours and cur_yours != state.yours_sha_at_load:
            raise ConcurrentModification("YOURS")
        cur_theirs = sha256_file(state.theirs_path)
        if cur_theirs and cur_theirs != state.theirs_sha_at_load:
            raise ConcurrentModification("THEIRS")

    # 2. Assemble (raises UnresolvedHunk if any decision is None).
    out_lines = assemble(state)

    # 3. Determine target mode.
    mode = state.yours_mode or 0o644

    # 4. Write to tmp with O_EXCL.
    tmp = state.yours_path.with_name(state.yours_path.name + TMP_SUFFIX + f".{os.getpid()}")
    if tmp.exists():
        tmp.unlink()
    write_lines_preserving(tmp, out_lines, state.encoding, state.newline,
                           state.trailing_newline, mode)

    # 5. Copy YOURS → .shedosbak (rolling).
    bak = state.yours_path.with_name(state.yours_path.name + BAK_SUFFIX)
    try:
        shutil.copy2(state.yours_path, bak)
    except OSError as e:
        _log(f"backup failed for {state.relpath}: {e}")

    # 6. Atomic rename tmp → YOURS.
    atomic_rename(tmp, state.yours_path)

    # 7. Remove .shedosnew.
    try:
        state.theirs_path.unlink()
    except OSError:
        pass

    # 8. Update manifest (sha + content).
    if state.src_path and state.src_path.is_file():
        _update_manifest(state.relpath, state.src_path)

    # 9. Clear draft.
    delete_draft(state.relpath)

    # 10. Kick the waybar conflict indicator. Best-effort: we've already
    # changed the live file; the badge is decoration. Keep the timeout
    # tight so a misbehaving signal path never blocks the save flow.
    try:
        subprocess.run(
            ["/usr/bin/shedman", "conflicts", "--refresh-waybar"],
            check=False,
            timeout=2,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.SubprocessError):
        pass



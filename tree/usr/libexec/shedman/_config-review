# and synced into the user's ~/.vscode/extensions/ on each --gui run
# so VS Code auto-loads it. The extension itself is a no-op for any
# workspace lacking the .shedman/ marker — it only ever activates SCM
# for our merge staging dirs.
_VSCODE_HELPER_SRC = Path("/usr/share/shedos-system/vscode-merge-helper")
_VSCODE_HELPER_VERSION = "1.3.0"


def _ensure_vscode_extension(code_bin: str) -> None:
    """Build a .vsix from the shipped extension files and install it
    via `code --install-extension`.

    VS Code only loads extensions registered in ~/.vscode/extensions/
    extensions.json; simply copying a directory there is silently
    ignored. `--install-extension <vsix>` is the official entry point
    that both unpacks the files and updates the registry. We build the
    vsix on the fly with Python's zipfile module (no external tools
    needed) from the package.json + extension.js shipped under
    /usr/share/shedos-system/vscode-merge-helper/.

    Idempotent: every run rebuilds the vsix and reinstalls. VS Code
    skips the install if it's already present at the same version.

    Skipped entirely when SHEDOS_VSCODE_BIN is set (test harness with
    fake-code) so tests don't mutate real user state.
    """
    if not _VSCODE_HELPER_SRC.is_dir():
        return
    if os.environ.get("SHEDOS_VSCODE_BIN"):
        return

    manifest = (
        '<?xml version="1.0" encoding="utf-8"?>\n'
        '<PackageManifest Version="2.0.0" '
        'xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011">\n'
        '  <Metadata>\n'
        f'    <Identity Language="en-US" Id="shedman-merge-helper" '
        f'Version="{_VSCODE_HELPER_VERSION}" Publisher="shedos"/>\n'
        '    <DisplayName>Shedman Merge Helper</DisplayName>\n'
        '    <Description>Auto-focus Source Control panel for '
        'shedman config --review workspaces.</Description>\n'
        '  </Metadata>\n'
        '  <Installation>\n'
        '    <InstallationTarget Id="Microsoft.VisualStudio.Code"/>\n'
        '  </Installation>\n'
        '  <Dependencies/>\n'
        '  <Assets>\n'
        '    <Asset Type="Microsoft.VisualStudio.Code.Manifest" '
        'Path="extension/package.json" Addressable="true"/>\n'
        '  </Assets>\n'
        '</PackageManifest>\n'
    )
    content_types = (
        '<?xml version="1.0" encoding="utf-8"?>\n'
        '<Types xmlns="http://schemas.openxmlformats.org/'
        'package/2006/content-types">\n'
        '  <Default Extension="json" ContentType="application/json"/>\n'
        '  <Default Extension="js" '
        'ContentType="application/javascript"/>\n'
        '  <Default Extension="vsixmanifest" ContentType="text/xml"/>\n'
        '</Types>\n'
    )

    import zipfile
    vsix = Path(tempfile.gettempdir()) / "shedman-merge-helper.vsix"
    try:
        with zipfile.ZipFile(vsix, "w", zipfile.ZIP_DEFLATED) as zf:
            zf.writestr("[Content_Types].xml", content_types)
            zf.writestr("extension.vsixmanifest", manifest)
            for src in _VSCODE_HELPER_SRC.iterdir():
                if src.is_file():
                    zf.write(src, f"extension/{src.name}")
    except OSError as e:
        _log(f"vsix build failed: {e}")
        return

    try:
        subprocess.run(
            [code_bin, "--install-extension", str(vsix), "--force"],
            check=False, capture_output=True, timeout=30,
        )
    except (OSError, subprocess.SubprocessError) as e:
        _log(f"vscode helper install failed: {e}")
    finally:
        try:
            vsix.unlink()
        except OSError:
            pass


    # ---------- File tree screen ----------
    class FileTreeScreen(Screen):
        # Tree widget owns Enter/arrow keys before screen-level bindings
        # fire, so vim-style nav is routed through the tree's own actions.
        # `n`/`p` walk between leaves (skipping directories) — the per-file
        # navigation users actually want when batching through conflicts.
        BINDINGS = [
            Binding("j,down",           "cursor_down",       "↓"),
            Binding("k,up",             "cursor_up",         "↑"),
            Binding("n",                "next_leaf",         "next file"),
            Binding("p",                "prev_leaf",         "prev file"),
            Binding("g",                "cursor_top",        "top"),
            Binding("G",                "cursor_bottom",     "bot"),
            Binding("l,right,enter",    "activate",          "open"),
            Binding("a",                "accept_all_theirs", "take-theirs-all"),
            Binding("K",                "keep_all_yours",    "keep-yours-all"),
            Binding("r",                "refresh",           "refresh"),
            Binding("slash",            "filter",            "filter"),
            Binding("escape",           "clear_filter",      "clear filter"),
            Binding("question_mark,f1", "help",              "help"),
            Binding("q",                "quit",              "quit"),
        ]

        def __init__(self, app_ref: "ReviewApp") -> None:
            super().__init__()
            self._app_ref = app_ref
            self._filter = ""

        def compose(self) -> ComposeResult:
            yield Banner("shedman config --review")
            self._tree: Tree = Tree("conflicts", id="conflict-tree")
            self._tree.show_root = False
            self._tree.guide_depth = 2
            yield self._tree
            yield Footer()

        def on_mount(self) -> None:
            self.refresh_tree()
            self._tree.focus()

        def _visible_conflicts(self) -> list[Conflict]:
            if not self._filter:
                return list(self._app_ref.conflicts)
            q = self._filter.lower()
            return [c for c in self._app_ref.conflicts if q in c.relpath.lower()]

        def _leaf_label(self, c: Conflict, filename: str):
            label = Text(filename)
            if c.kind == "text":
                if c.has_base:
                    hunks = c.hunk_count if c.hunk_count >= 0 else "?"
                    label.append(f"  [3-way • {hunks} hunks]", style=THEME.dim)
                else:
                    label.append("  [2-way • BASE missing]", style=THEME.warning)
            else:
                label.append(f"  [{c.kind}]", style=THEME.dim)
            return label

        def refresh_tree(self) -> None:
            self._tree.clear()
            dir_nodes: dict[str, TreeNode] = {"": self._tree.root}
            for c in sorted(self._visible_conflicts(), key=lambda x: x.relpath):
                parts = c.relpath.split("/")
                parent = self._tree.root
                current = ""
                for part in parts[:-1]:
                    current = f"{current}/{part}" if current else part
                    if current not in dir_nodes:
                        new_dir = parent.add(f"{part}/", data=None, expand=True)
                        dir_nodes[current] = new_dir
                    parent = dir_nodes[current]
                parent.add_leaf(self._leaf_label(c, parts[-1]), data=c)
            self._update_banner()

        def _update_banner(self) -> None:
            banner = self.query_one("#banner", Banner)
            total = len(self._app_ref.conflicts)
            visible = self._visible_conflicts()
            bin_n = sum(1 for c in self._app_ref.conflicts if c.kind == "binary")
            if self._filter:
                banner.update(
                    f"shedman config --review  —  {len(visible)}/{total} "
                    f"conflict(s) ({bin_n} binary)   "
                    f"filter=[b {THEME.warning}]{self._filter}[/]   "
                    f"/ edit  esc clear   ? help   q quit")
            else:
                banner.update(
                    f"shedman config --review  —  {total} conflict(s) "
                    f"({bin_n} binary)   n/p file   / filter   ? help   q quit")

        def _visible_leaves(self) -> list[TreeNode]:
            # DFS from root, honouring expansion state: a collapsed dir's
            # leaves are not visible, so n/p shouldn't visit them.
            out: list[TreeNode] = []
            def walk(node: TreeNode) -> None:
                for child in node.children:
                    if child.data is not None:
                        out.append(child)
                    elif child.is_expanded:
                        walk(child)
            walk(self._tree.root)
            return out

        def action_quit(self) -> None:
            self.app.exit()

        def action_cursor_down(self) -> None:
            self._tree.action_cursor_down()

        def action_cursor_up(self) -> None:
            self._tree.action_cursor_up()

        def action_cursor_top(self) -> None:
            self._tree.move_cursor_to_line(0)

        def action_cursor_bottom(self) -> None:
            # Last visible node = deepest right-most descendant of expanded chain.
            node = self._tree.root
            while node.children and (node is self._tree.root or node.is_expanded):
                node = node.children[-1]
            if node is not self._tree.root:
                self._tree.move_cursor(node)

        def action_next_leaf(self) -> None:
            self._move_to_leaf(+1)

        def action_prev_leaf(self) -> None:
            self._move_to_leaf(-1)

        def _move_to_leaf(self, direction: int) -> None:
            leaves = self._visible_leaves()
            if not leaves:
                return
            cur = self._tree.cursor_node
            if cur is not None and cur in leaves:
                idx = (leaves.index(cur) + direction) % len(leaves)
            else:
                idx = 0 if direction > 0 else len(leaves) - 1
            self._tree.move_cursor(leaves[idx])

        def action_activate(self) -> None:
            node = self._tree.cursor_node
            if node is None or node is self._tree.root:
                return
            if node.data is not None:
                self._app_ref.open_conflict(node.data)
            else:
                node.toggle()

        def on_tree_node_selected(self, event) -> None:
            # Mouse click on a leaf — open it. Dirs use NodeExpanded/Collapsed
            # which Textual handles internally; nothing to do here for those.
            node = event.node
            if node is None or node.data is None:
                return
            self._app_ref.open_conflict(node.data)

        def action_help(self) -> None:
            self.app.push_screen(HelpScreen())

        def action_accept_all_theirs(self) -> None:
            visible = self._visible_conflicts()
            scope = ("every visible file" if self._filter else "every file")
            def after(ans: Optional[bool]) -> None:
                if ans:
                    self._app_ref.bulk_accept_theirs(visible)
                    self.refresh_tree()
            self.app.push_screen(
                ConfirmScreen("Accept THEIRS for all files",
                              f"Replace {scope} ({len(visible)}) with its\n"
                              f"upstream version. A .shedosbak is written for each."),
                after,
            )

        def action_keep_all_yours(self) -> None:
            visible = self._visible_conflicts()
            scope = ("every visible .shedosnew" if self._filter else "every .shedosnew")
            def after(ans: Optional[bool]) -> None:
                if ans:
                    self._app_ref.bulk_keep_yours(visible)
                    self.refresh_tree()
            self.app.push_screen(
                ConfirmScreen("Keep YOURS for all files",
                              f"Delete {scope} ({len(visible)}) and leave\n"
                              f"your live copies as-is."),
                after,
            )

        def action_refresh(self) -> None:
            self._app_ref.rescan()
            self.refresh_tree()

        def action_filter(self) -> None:
            def after(value: Optional[str]) -> None:
                if value is None:
                    return
                self._filter = value.strip()
                self.refresh_tree()
            self.app.push_screen(FilterPromptScreen(self._filter), after)

        def action_clear_filter(self) -> None:
            if self._filter:
                self._filter = ""
                self.refresh_tree()

    # ---------- Merge screen ----------
    class MergeScreen(Screen):
        # Navigation split:
        #   j/k/↑/↓/PgUp/PgDn/g/G  → scroll all panes in lockstep
        #   n/p                    → move "current hunk" and re-center
        #   y/t/b/B/x              → decision on current hunk (advances)
        # Footer displays every binding with show=True in insertion order.
        # We surface the scroll keys (even the obvious arrow aliases) so the
        # user can verify the TUI actually handles them. The previous
        # hidden-arrow design made it look like scroll was broken.
        BINDINGS = [
            # Footer-visible essentials.
            Binding("y",            "take_yours",       "YOURS"),
            Binding("t",            "take_theirs",      "THEIRS"),
            Binding("b",            "take_both_yt",     "both Y→T"),
            Binding("B",            "take_both_ty",     "both T→Y"),
            Binding("n",            "next_hunk",        "next hunk"),
            Binding("p",            "prev_hunk",        "prev hunk"),
            Binding("s",            "save",             "save"),
            Binding("q",            "cancel",           "cancel"),
            Binding("question_mark,f1", "help",         "help"),

            # Bound but hidden from footer — surfaced in the help modal.
            Binding("j,down",          "scroll_down",      "↓ line",        show=False),
            Binding("k,up",            "scroll_up",        "↑ line",        show=False),
            Binding("h,left",          "pan_left",         "← pan",         show=False),
            Binding("l,right",         "pan_right",        "→ pan",         show=False),
            Binding("z",               "toggle_wrap",      "wrap",          show=False),
            Binding("pagedown,ctrl+d", "scroll_page_down", "PgDn",          show=False),
            Binding("pageup,ctrl+u",   "scroll_page_up",   "PgUp",          show=False),
            Binding("g",               "scroll_home",      "top",           show=False),
            Binding("G",               "scroll_end",       "bot",           show=False),
            Binding("u",               "undo",             "undo",          show=False),
            Binding("shift+a",         "all_yours",        "all-Y",         show=False),
            Binding("shift+t",         "all_theirs",       "all-T",         show=False),
            Binding("d",               "raw_diff",         "raw-diff",      show=False),
            Binding("e",              "edit_yours",       "edit",          show=False),
            Binding("shift+e",         "edit_merged",      "edit merged",   show=False),
        ]

        def __init__(self, app_ref: "ReviewApp", state: MergeState) -> None:
            super().__init__()
            self._app_ref = app_ref
            self.state = state
            self.current = 0
            # Soft-wrap off by default: minified JSON / long one-liners look
            # awful when reflowed. `z` toggles to Rich's wrap-at-pane-width
            # mode when the user prefers vertical expansion over pan.
            self._wrap = False
            self.rows: list[AlignedRow] = build_aligned_rows(state)
            # row index → index within state.hunks (for n/p + auto-scroll).
            self._row_of_hunk: dict[int, int] = {}
            for idx, r in enumerate(self.rows):
                if r.hunk_index is not None and r.hunk_index not in self._row_of_hunk:
                    self._row_of_hunk[r.hunk_index] = idx

        def compose(self) -> ComposeResult:
            yield Banner("")
            self.pane_yours  = DiffPane("YOURS (live)",        kind="YOURS")
            self.pane_base   = DiffPane("RESULT (preview)",    kind="BASE")
            self.pane_theirs = DiffPane("THEIRS (upstream)",   kind="THEIRS")
            yield Horizontal(self.pane_yours, self.pane_base,
                             self.pane_theirs, id="merge-row")
            self.strip = HunkStrip()
            yield self.strip
            # Footer auto-renders every `show=True` binding; it's our source
            # of truth for "what keys do what", so the user never has to
            # memorize or hit `?` just to find ctrl-d/pgup/g/G.
            yield Footer()

        def on_mount(self) -> None:
            banner = self.query_one("#banner", Banner)
            mode = "2-way (base unavailable)" if self.state.is_2way else "3-way"
            banner.set_mode(self.state.is_2way)
            banner.update(f"{self.state.relpath}   {mode}   "
                          f"hunk {self.current+1}/{len(self.state.hunks)}   "
                          f"pkg={self.state.pkg}   ? help   s save")
            self._render_all()
            # Publish this screen so SIGTERM/SIGHUP handlers can snapshot
            # the live (state, current_hunk) pair to a draft if the process
            # is killed. Storing the screen (not a tuple) so the handler
            # reads the current hunk at the moment of the signal, not at
            # on_mount time.
            _active_merge_ref[:] = [self]
            # Scroll to the first hunk on entry so the user lands on something
            # actionable, not the top of a 500-line file.
            self.call_after_refresh(self._focus_current_hunk)

        def on_unmount(self) -> None:
            _active_merge_ref[:] = []

        def _panes(self) -> list["DiffPane"]:
            return [self.pane_yours, self.pane_base, self.pane_theirs]

        def _render_all(self) -> None:
            cur = self.current if 0 <= self.current < len(self.state.hunks) else None
            self.pane_yours.set_content(
                render_pane_text(self.rows, "YOURS", cur, wrap=self._wrap))
            self.pane_theirs.set_content(
                render_pane_text(self.rows, "THEIRS", cur, wrap=self._wrap))
            # Middle pane re-renders against the current decision map so
            # y/t/b/B/u/A/T all produce a visible result-preview update.
            decisions = {h.index: h.decision for h in self.state.hunks}
            self.pane_base.set_content(
                render_pane_text(self.rows, "BASE", cur,
                                 decisions=decisions, wrap=self._wrap))
            self.strip.update_from(self.state, self.current)
            banner = self.query_one("#banner", Banner)
            wrap_tag = "wrap" if self._wrap else "pan"
            banner.update(
                f"{self.state.relpath}   "
                f"{'2-way' if self.state.is_2way else '3-way'}   "
                f"hunk {self.current+1}/{len(self.state.hunks)}   "
                f"pkg={self.state.pkg}   [{wrap_tag}]   ? help   s save")

        # --- Scroll synchronization: all three panes move together. -------
        def _sync_scroll(self, y: int) -> None:
            for p in self._panes():
                p.scroll_to(y=y, animate=False)

        def _scroll_by(self, delta: int) -> None:
            pane = self.pane_yours
            new_y = max(0, pane.scroll_y + delta)
            self._sync_scroll(new_y)

        def _center_on_row(self, row_idx: int) -> None:
            # Place the target row near the top of the viewport (with a little
            # lead-in so the user sees context above it).
            pane = self.pane_yours
            vh = pane.size.height or 10
            target = max(0, row_idx - max(2, vh // 4))
            self._sync_scroll(target)

        def action_scroll_down(self) -> None:       self._scroll_by(1)
        def action_scroll_up(self) -> None:         self._scroll_by(-1)
        def action_scroll_page_down(self) -> None:
            self._scroll_by(max(1, (self.pane_yours.size.height or 10) - 2))
        def action_scroll_page_up(self) -> None:
            self._scroll_by(-max(1, (self.pane_yours.size.height or 10) - 2))
        def action_scroll_home(self) -> None:       self._sync_scroll(0)
        def action_scroll_end(self) -> None:        self._sync_scroll(len(self.rows))

        # --- Horizontal pan (no-op when wrap is on; content never overflows) --
        PAN_STEP = 8

        def _sync_pan(self, x: int) -> None:
            for p in self._panes():
                p.scroll_to(x=x, y=p.scroll_y, animate=False)

        def action_pan_left(self) -> None:
            if self._wrap:
                return
            new_x = max(0, (self.pane_yours.scroll_x or 0) - self.PAN_STEP)
            self._sync_pan(new_x)

        def action_pan_right(self) -> None:
            if self._wrap:
                return
            new_x = (self.pane_yours.scroll_x or 0) + self.PAN_STEP
            self._sync_pan(new_x)

        def action_toggle_wrap(self) -> None:
            self._wrap = not self._wrap
            for p in self._panes():
                p.set_class(self._wrap, "wrap")
            if self._wrap:
                # Turning wrap on: horizontal scroll offset becomes meaningless,
                # reset so the user doesn't see a phantom scroll state when
                # they toggle back.
                self._sync_pan(0)
            self._render_all()

        def _focus_current_hunk(self) -> None:
            if 0 <= self.current < len(self.state.hunks):
                row = self._row_of_hunk.get(self.current)
                if row is not None:
                    self._center_on_row(row)

        def _decision_and_advance(self, side: Side) -> None:
            if not self.state.hunks:
                return
            h = self.state.hunks[self.current]
            self.state.undo_stack.append((h.index, h.decision))
            if len(self.state.undo_stack) > UNDO_DEPTH:
                self.state.undo_stack.pop(0)
            h.decision = side
            save_draft(self.state, self.current)
            if self.current < len(self.state.hunks) - 1:
                self.current += 1
            self._render_all()
            self._focus_current_hunk()

        def action_next_hunk(self) -> None:
            if self.current < len(self.state.hunks) - 1:
                self.current += 1
                self._render_all()
                self._focus_current_hunk()

        def action_prev_hunk(self) -> None:
            if self.current > 0:
                self.current -= 1
                self._render_all()
                self._focus_current_hunk()

        def action_take_yours(self) -> None: self._decision_and_advance(Side.YOURS)
        def action_take_theirs(self) -> None: self._decision_and_advance(Side.THEIRS)
        def action_take_both_yt(self) -> None: self._decision_and_advance(Side.BOTH_YT)
        def action_take_both_ty(self) -> None: self._decision_and_advance(Side.BOTH_TY)

        def action_undo(self) -> None:
            if not self.state.undo_stack:
                self.app.bell()
                return
            idx, prev = self.state.undo_stack.pop()
            for h in self.state.hunks:
                if h.index == idx:
                    h.decision = prev
                    break
            self._render_all()

        def action_all_yours(self) -> None:
            for h in self.state.hunks:
                h.decision = Side.YOURS
            self._render_all()

        def action_all_theirs(self) -> None:
            for h in self.state.hunks:
                h.decision = Side.THEIRS
            self._render_all()

        def action_save(self) -> None:
            unresolved = self.state.unresolved_count()
            if unresolved:
                def after(ans: Optional[bool]) -> None:
                    if ans:
                        self._pick_defaults_and_save()
                self.app.push_screen(
                    ConfirmScreen(
                        f"{unresolved} hunk(s) unresolved",
                        "Apply the auto-classified default for each unresolved hunk\n"
                        "and save? (unclassified hunks will keep YOURS)",
                    ),
                    after,
                )
                return
            self._do_save()

        def _pick_defaults_and_save(self) -> None:
            for h in self.state.hunks:
                if h.decision is not None:
                    continue
                if h.kind == "yours-only":
                    h.decision = Side.YOURS
                elif h.kind == "theirs-only":
                    h.decision = Side.THEIRS
                else:
                    h.decision = Side.YOURS  # conservative
            self._do_save()

        def _do_save(self) -> None:
            try:
                save_merged(self.state)
            except ConcurrentModification as e:
                self.app.push_screen(
                    ConfirmScreen(f"{e.which} changed on disk",
                                  "Force overwrite with the current merge? "
                                  "(choose No to cancel and reload the file by hand)"),
                    lambda ans: self._force_save() if ans else None,
                )
                return
            except UnresolvedHunk:
                self.app.bell()
                return
            except OSError as e:
                self._show_io_error(e)
                return
            self._app_ref.mark_resolved(self.state.relpath)
            self.app.pop_screen()

        def _force_save(self) -> None:
            try:
                save_merged(self.state, force=True)
            except UnresolvedHunk:
                return
            except OSError as e:
                self._show_io_error(e)
                return
            self._app_ref.mark_resolved(self.state.relpath)
            self.app.pop_screen()

        def _show_io_error(self, e: OSError) -> None:
            # Surface filesystem-level failures (read-only $HOME, ENOSPC,
            # permission denied, etc.) as a modal instead of letting the
            # exception bubble up and take the TUI down.
            if e.errno == errno.EROFS:
                title = "$HOME is read-only"
                body = ("The filesystem holding your home directory is mounted\n"
                        "read-only. Remount read-write before saving:\n"
                        "  sudo mount -o remount,rw /home\n"
                        "Your draft has been preserved; pick up where you left off.")
            elif e.errno == errno.ENOSPC:
                title = "No space left on device"
                body = ("Free up space in $HOME and try again. Your draft is saved.")
            elif e.errno == errno.EACCES:
                title = "Permission denied"
                body = (f"{e.filename or self.state.relpath}\n"
                        "Check ownership and mode on the file and its parent directory.")
            else:
                title = f"I/O error ({e.errno})"
                body = str(e)
            _log(f"save I/O error for {self.state.relpath}: {e}")
            save_draft(self.state, self.current)
            self.app.push_screen(ConfirmScreen(title, body, default_yes=True))

        def action_raw_diff(self) -> None:
            self.app.push_screen(RawDiffScreen(
                self.state.relpath,
                self.state.yours_lines,
                self.state.theirs_lines,
            ))

        def action_edit_yours(self) -> None:
            self._edit_and_reload(self.state.yours_path)

        def action_edit_merged(self) -> None:
            # Write current merged-so-far to a tempfile, let $EDITOR edit,
            # then treat it as the new YOURS baseline for further merging.
            try:
                lines = assemble(self.state)
            except UnresolvedHunk:
                # Assemble with YOURS defaults for the preview.
                defaults = [(h.index, h.decision) for h in self.state.hunks]
                for h in self.state.hunks:
                    if h.decision is None:
                        h.decision = Side.YOURS
                lines = assemble(self.state)
                for idx, prev in defaults:
                    for h in self.state.hunks:
                        if h.index == idx:
                            h.decision = prev
                            break
            tmp = tempfile.NamedTemporaryFile(
                mode="w", suffix=Path(self.state.relpath).suffix or ".txt",
                delete=False, encoding=self.state.encoding,
            )
            tmp.write(self.state.newline.join(lines))
            if self.state.trailing_newline:
                tmp.write(self.state.newline)
            tmp.close()
            self._edit_and_reload(Path(tmp.name))

        def _edit_and_reload(self, path: Path) -> None:
            editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or "nano"
            try:
                with self.app.suspend():
                    rc = subprocess.call([editor, str(path)])
            except Exception as e:
                self.app.bell()
                _log(f"editor handoff failed: {e}")
                return
            if rc != 0:
                _log(f"editor exited {rc}")

        def action_cancel(self) -> None:
            save_draft(self.state, self.current)
            self.app.pop_screen()

        def action_help(self) -> None:
            self.app.push_screen(HelpScreen())

    # ---------- App wrapper ----------
    class ReviewApp(App):
        CSS = APP_CSS
        TITLE = "shedman config --review"
        BINDINGS = [Binding("ctrl+c", "quit", "quit", priority=True)]

        def __init__(self, conflicts: list[Conflict], *, start_file: Optional[str],
                     walk_all: bool, force_2way: bool) -> None:
            super().__init__()
            self.conflicts = list(conflicts)
            self.start_file = start_file
            self.walk_all = walk_all
            self.force_2way = force_2way
            self._resolved: set[str] = set()

        def on_mount(self) -> None:
            self.push_screen(FileTreeScreen(self))
            if self.start_file:
                for c in self.conflicts:
                    if c.relpath == self.start_file:
                        self.open_conflict(c)
                        break
            elif self.walk_all and self.conflicts:
                self.open_conflict(self.conflicts[0])

        def open_conflict(self, c: Conflict) -> None:
            if c.kind == "binary":
                self.push_screen(ConfirmScreen(
                    f"Binary file: {c.relpath}",
                    "Line-level merge is not possible for binary files.\n"
                    "Yes → Take THEIRS (replace YOURS)\n"
                    "No  → Keep YOURS (delete .shedosnew)"
                ), lambda ans: self._binary_resolve(c, ans))
                return
            if c.kind == "symlink":
                self.push_screen(ConfirmScreen(
                    f"Symlink: {c.relpath}",
                    "YOURS is a symlink. The review tool does not merge symlinks.\n"
                    "Yes → delete .shedosnew and leave the symlink\n"
                    "No  → skip"
                ), lambda ans: self._skip_resolve(c, ans))
                return
            if c.kind == "orphan":
                self.push_screen(ConfirmScreen(
                    f"Orphan: {c.relpath}",
                    "No shedos-* package currently owns this file.\n"
                    "Yes → delete .shedosnew\n"
                    "No  → skip"
                ), lambda ans: self._skip_resolve(c, ans))
                return
            if c.kind == "missing-yours":
                self.push_screen(ConfirmScreen(
                    f"Missing live copy: {c.relpath}",
                    "YOURS doesn't exist. Promote THEIRS to YOURS?\n"
                    "Yes → mv .shedosnew → live path\n"
                    "No  → delete .shedosnew"
                ), lambda ans: self._promote_theirs(c, ans))
                return
            try:
                state = load_merge_state(c, force_2way=self.force_2way)
            except OSError as e:
                _log(f"load failed for {c.relpath}: {e}")
                return
            draft = load_draft(c.relpath)
            if draft:
                def after(ans: Optional[bool]) -> None:
                    if ans:
                        apply_draft(state, draft)
                    self.push_screen(MergeScreen(self, state))
                self.push_screen(ConfirmScreen(
                    "Resume draft?",
                    f"A draft from {draft.get('saved_at', '?')} was found.\n"
                    "Yes → resume   No → fresh start"
                ), after)
                return
            self.push_screen(MergeScreen(self, state))

        def _binary_resolve(self, c: Conflict, take_theirs: Optional[bool]) -> None:
            if take_theirs is None:
                return
            try:
                if take_theirs:
                    shutil.copy2(c.yours_path, c.yours_path.with_name(c.yours_path.name + BAK_SUFFIX))
                    shutil.copy2(c.theirs_path, c.yours_path)
                c.theirs_path.unlink()
                if c.src_path:
                    _update_manifest(c.relpath, c.src_path)
            except OSError as e:
                _log(f"binary resolve failed for {c.relpath}: {e}")
            self.mark_resolved(c.relpath)

        def _skip_resolve(self, c: Conflict, delete: Optional[bool]) -> None:
            if delete:
                try:
                    c.theirs_path.unlink()
                except OSError:
                    pass
                self.mark_resolved(c.relpath)

        def _promote_theirs(self, c: Conflict, promote: Optional[bool]) -> None:
            if promote is None:
                return
            try:
                if promote:
                    os.rename(str(c.theirs_path), str(c.yours_path))
                else:
                    c.theirs_path.unlink()
                if c.src_path:
                    _update_manifest(c.relpath, c.src_path)
            except OSError as e:
                _log(f"promote failed for {c.relpath}: {e}")
            self.mark_resolved(c.relpath)

        def mark_resolved(self, relpath: str) -> None:
            self._resolved.add(relpath)
            self.conflicts = [c for c in self.conflicts if c.relpath not in self._resolved]
            top = self.screen_stack[-1] if self.screen_stack else None
            if isinstance(top, FileTreeScreen):
                top.refresh_tree()
            if not self.conflicts:
                self.exit()

        def rescan(self) -> None:
            self.conflicts, _ = scan_conflicts()
            self.conflicts, _ = auto_resolve_identical(self.conflicts)
            populate_hunk_counts(self.conflicts, force_2way=self.force_2way)

        def bulk_accept_theirs(self, scope: Optional[list[Conflict]] = None) -> None:
            targets = list(scope) if scope is not None else list(self.conflicts)
            for c in targets:
                if c.kind == "text" and c.yours_path.exists():
                    try:
                        shutil.copy2(c.yours_path,
                                     c.yours_path.with_name(c.yours_path.name + BAK_SUFFIX))
                        shutil.copy2(c.theirs_path, c.yours_path)
                        c.theirs_path.unlink()
                        if c.src_path:
                            _update_manifest(c.relpath, c.src_path)
                    except OSError:
                        continue
                    self._resolved.add(c.relpath)
            self.conflicts = [c for c in self.conflicts if c.relpath not in self._resolved]
            if not self.conflicts:
                self.exit()

        def bulk_keep_yours(self, scope: Optional[list[Conflict]] = None) -> None:
            targets = list(scope) if scope is not None else list(self.conflicts)
            for c in targets:
                try:
                    c.theirs_path.unlink()
                except OSError:
                    pass
                self._resolved.add(c.relpath)
            self.conflicts = [c for c in self.conflicts if c.relpath not in self._resolved]
            if not self.conflicts:
                self.exit()

    # Install the inline runner.
    def _runner(conflicts: list[Conflict], *, start_file: Optional[str],
                walk_all: bool, force_2way: bool) -> int:
        if not conflicts:
            print("Nothing to review. All configs are in sync.")
            return 0
        cols = shutil.get_terminal_size((80, 24)).columns
        rows = shutil.get_terminal_size((80, 24)).lines
        if cols < MIN_COLS or rows < MIN_ROWS:
            print(f"shedman config --review: terminal too small "
                  f"(need {MIN_COLS}×{MIN_ROWS}, have {cols}×{rows}). "
                  f"Resize or run with --list.", file=sys.stderr)
            return 2
        install_signal_handlers()
        app = ReviewApp(conflicts, start_file=start_file,
                        walk_all=walk_all, force_2way=force_2way)
        app.run()
        return 0

    globals()["_run_app_inline"] = _runner


_load_textual_ui()



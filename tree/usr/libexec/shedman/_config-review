    class RawDiffScreen(ModalScreen):
        """Full-screen pager for unified YOURS↔THEIRS diff.

        Kept deliberately simple: scrollable container with a single
        pre-rendered ``Text`` block. Colors follow the Catppuccin palette
        (green additions, red deletions, mauve hunk headers) so the view
        matches the inline merge pane semantics.
        """

        BINDINGS = [Binding("escape,q,d", "app.pop_screen", "close")]

        def __init__(self, relpath: str, yours_lines: list[str],
                     theirs_lines: list[str]) -> None:
            super().__init__()
            self._relpath = relpath
            self._yours = yours_lines
            self._theirs = theirs_lines

        def compose(self) -> ComposeResult:
            diff = list(unified_diff(self._yours, self._theirs,
                                     fromfile=f"YOURS/{self._relpath}",
                                     tofile=f"THEIRS/{self._relpath}",
                                     lineterm=""))
            body = Text()
            if not diff:
                body.append(
                    "(no textual difference between YOURS and THEIRS)\n",
                    style=PALETTE["overlay0"],
                )
            for line in diff:
                if line.startswith("+++") or line.startswith("---"):
                    style = f"bold {PALETTE['blue']}"
                elif line.startswith("@@"):
                    style = f"bold {PALETTE['mauve']}"
                elif line.startswith("+"):
                    style = PALETTE["green"]
                elif line.startswith("-"):
                    style = PALETTE["red"]
                else:
                    style = PALETTE["text"]
                body.append(line + "\n", style=style)
            body.append(
                "\n[esc/q/d to close]\n",
                style=PALETTE["overlay0"],
            )
            scroller = VerticalScroll(
                Static(body, expand=True),
                id="raw-diff-scroll",
            )
            scroller.can_focus = True
            yield scroller


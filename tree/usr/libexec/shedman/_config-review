def _vscode_binary() -> str:
    """Resolve the VS Code / VSCodium executable on PATH, or "" if absent.

    Both Arch's `code` (extra repo, OSS build) and `visual-studio-code-bin`
    (AUR, Microsoft proprietary build) install /usr/bin/code, so a single
    lookup covers both. VSCodium installs `codium` and is checked as a
    courtesy fallback for users who prefer it. Override with
    SHEDOS_VSCODE_BIN for tests.
    """
    override = os.environ.get("SHEDOS_VSCODE_BIN")
    if override:
        return override if shutil.which(override) or os.path.isabs(override) else ""
    for name in ("code", "codium"):
        if shutil.which(name):
            return name
    return ""


def _has_conflict_markers(path: Path) -> bool:
    try:
        text = path.read_text(errors="replace")
    except OSError:
        return False
    return bool(_CONFLICT_MARKER_RE.search(text))


def save_merged_from_bytes(c: Conflict, content: bytes) -> None:
    """Atomic save of new content for a GUI-resolved conflict.

    Same on-disk choreography as save_merged() (tmp+fsync, .shedosbak
    of pre-merge YOURS, atomic rename, .shedosnew unlink, manifest
    advance) but takes raw bytes from the GUI staging dir instead of
    assembling from hunk decisions.
    """
    yours = c.yours_path
    mode = yours.stat().st_mode & 0o777 if yours.exists() else 0o644

    tmp = yours.with_name(yours.name + TMP_SUFFIX + f".{os.getpid()}")
    if tmp.exists():
        tmp.unlink()
    fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(content)
            fh.flush()
            os.fsync(fh.fileno())
    except OSError:
        tmp.unlink(missing_ok=True)
        raise

    if yours.exists():
        try:
            shutil.copy2(yours, yours.with_name(yours.name + BAK_SUFFIX))
        except OSError as e:
            _log(f"backup failed for {c.relpath}: {e}")

    atomic_rename(tmp, yours)

    try:
        c.theirs_path.unlink()
    except OSError:
        pass

    if c.src_path and c.src_path.is_file():
        _update_manifest(c.relpath, c.src_path)


def _stage_for_vscode(conflicts: list[Conflict], force_2way: bool,
                      staging: Path) -> dict[str, bytes]:
    """Materialise the conflicts as a real git mid-merge state.

    The staging dir is initialised as a git repo with three commits per
    file (BASE on `main`, THEIRS on a branch, YOURS back on `main`),
    then `git merge` is run so every conflict file lands in the working
    tree with standard merge markers. VS Code's git integration detects
    the mid-merge state automatically: each file gets a conflict badge
    in the Explorer; clicking a file opens the merge editor (the
    default behaviour of `git.mergeEditor: true`); the per-file
    conflict scope keeps each merge editor's CodeLens labels isolated.

    For 2-way conflicts (BASE missing) we synthesise BASE as an empty
    file so the merge actually conflicts — a non-empty BASE equal to
    YOURS would fast-forward without writing any markers.

    Returns the post-merge snapshot of each file (still containing
    markers) for the change detection done after VS Code closes.
    """
    def git(*args: str) -> None:
        subprocess.run(
            ["git", "-C", str(staging), *args],
            check=True, capture_output=True,
        )

    # Standalone repo: no global config, no signing, predictable
    # markers. -b main pins the initial branch name regardless of the
    # user's init.defaultBranch.
    git("init", "-q", "-b", "main")
    git("config", "user.email", "shedman-review@localhost")
    git("config", "user.name", "ShedMan Review")
    git("config", "commit.gpgsign", "false")
    git("config", "merge.conflictStyle", "merge")

    def lay_out(picker) -> None:
        """Write picker(c) into staging/c.relpath for every conflict."""
        for c in conflicts:
            dst = staging / c.relpath
            dst.parent.mkdir(parents=True, exist_ok=True)
            src = picker(c)
            if src is None:
                dst.write_bytes(b"")
            else:
                shutil.copy2(src, dst)

    # BASE commit on main.
    def base_src(c: Conflict):
        if c.has_base and not force_2way:
            blob = CONTENT_ROOT / c.relpath
            if blob.is_file():
                return blob
        return None  # synthesise empty
    lay_out(base_src)
    git("add", "--", *[c.relpath for c in conflicts])
    git("commit", "-q", "-m", "base")

    # THEIRS commit on a sibling branch.
    git("checkout", "-q", "-b", "theirs")
    lay_out(lambda c: c.theirs_path)
    git("add", "--", *[c.relpath for c in conflicts])
    git("commit", "-q", "-m", "theirs")

    # YOURS commit back on main.
    git("checkout", "-q", "main")
    lay_out(lambda c: c.yours_path)
    git("add", "--", *[c.relpath for c in conflicts])
    git("commit", "-q", "-m", "yours")

    # Merge theirs — every file conflicts. `git merge` returns non-zero
    # on conflict, which is the success case here; check=False.
    subprocess.run(
        ["git", "-C", str(staging), "merge", "--no-ff", "-q",
         "-m", "shedman review", "theirs"],
        check=False, capture_output=True,
    )

    pre: dict[str, bytes] = {}
    for c in conflicts:
        try:
            pre[c.relpath] = (staging / c.relpath).read_bytes()
        except OSError:
            pre[c.relpath] = b""

    vscode_dir = staging / ".vscode"
    vscode_dir.mkdir(parents=True, exist_ok=True)
    settings_dst = vscode_dir / "settings.json"
    if _VSCODE_SETTINGS_TEMPLATE.is_file():
        shutil.copy2(_VSCODE_SETTINGS_TEMPLATE, settings_dst)
    else:
        settings_dst.write_text(_DEFAULT_VSCODE_SETTINGS)

    # Marker dir + file the shedman-merge-helper VS Code extension
    # checks for. Its presence tells the extension "this workspace
    # is a shedman config-review session, focus the Source Control
    # panel and open the first conflict". Hidden from Explorer via
    # files.exclude in settings.json. The MARKER file inside makes
    # the directory non-empty so VS Code's workspace scanner sees it
    # (relevant if we ever swap activation to workspaceContains).
    marker_dir = staging / ".shedman"
    marker_dir.mkdir(exist_ok=True)
    (marker_dir / "MARKER").write_text("shedman config --review staging\n")
    return pre


def _run_vscode(conflicts: list[Conflict], *, force_2way: bool) -> int:
    """Open VS Code on a git mid-merge workspace and copy back on close.

    The staging dir is set up as a real git repo with each conflict
    materialised as a mid-merge state, so VS Code's native git
    integration handles per-file conflict scoping (Explorer badges,
    Source Control panel, click-to-merge-editor). The whole session is
    a single `code --new-window --wait <staging>` invocation that
    blocks until the user closes the window; we then walk the result
    files and copy back anything resolved cleanly.
    """
    if not conflicts:
        print("Nothing to review. All configs are in sync.")
        return 0

    text_conflicts = [c for c in conflicts if c.kind == "text"]
    non_text = [c for c in conflicts if c.kind != "text"]

    if non_text:
        print(f"shedman config --review: {len(non_text)} non-text "
              f"conflict(s) need the TUI. Re-run with --tui to handle them.",
              file=sys.stderr)
        for c in non_text[:5]:
            print(f"  ~/{c.relpath}  [{c.kind}]", file=sys.stderr)
        if len(non_text) > 5:
            print(f"  ... and {len(non_text) - 5} more.", file=sys.stderr)

    if not text_conflicts:
        return 0

    code = _vscode_binary()
    if not code:
        print("shedman config --review: --gui requested but neither "
              "`code` nor `codium` is on PATH. Falling back to TUI.",
              file=sys.stderr)
        return _run_textual(conflicts, start_file=None, walk_all=False,
                            force_2way=force_2way)

    if not shutil.which("git"):
        print("shedman config --review: --gui needs git to stage "
              "conflicts. Falling back to TUI.", file=sys.stderr)
        return _run_textual(conflicts, start_file=None, walk_all=False,
                            force_2way=force_2way)

    staging = Path(tempfile.mkdtemp(prefix="shedman-review-"))
    try:
        try:
            pre = _stage_for_vscode(text_conflicts, force_2way, staging)
        except subprocess.CalledProcessError as e:
            cmd = " ".join(e.cmd[-3:]) if e.cmd else "git"
            err = (e.stderr or b"").decode(errors="replace").strip()
            print(f"failed to stage conflicts ({cmd}): {err}",
                  file=sys.stderr)
            return 1

        # Install the shedman-merge-helper extension via
        # `code --install-extension <vsix>` so VS Code auto-loads it
        # on the upcoming window open. The extension focuses the SCM
        # panel for workspaces that contain a .shedman/ marker (i.e.
        # ours), and no-ops everywhere else.
        _ensure_vscode_extension(code)

        # Identify the first conflicted file (any with markers from
        # git merge) — we'll pre-open its merge editor via a separate
        # `code --reuse-window --merge` call after the workspace
        # window is up. Subsequent files: user clicks them in the SCM
        # panel (those clicks open the merge editor directly).
        first_conflicted: Optional[Conflict] = None
        for c in text_conflicts:
            if _CONFLICT_MARKER_RE.search(
                    pre[c.relpath].decode(errors="replace")):
                first_conflicted = c
                break

        first_merge_argv: list[str] = []
        if first_conflicted is not None:
            sidecar_dir = staging / ".shedman" / "sources"
            sidecar_dir.mkdir(parents=True, exist_ok=True)
            relp = Path(first_conflicted.relpath)
            suffix = relp.suffix
            stem = relp.stem if suffix else relp.name
            y = sidecar_dir / f"{stem}.YOURS{suffix}"
            t = sidecar_dir / f"{stem}.THEIRS{suffix}"
            b = sidecar_dir / f"{stem}.BASE{suffix}"
            shutil.copy2(first_conflicted.yours_path, y)
            shutil.copy2(first_conflicted.theirs_path, t)
            if first_conflicted.has_base and not force_2way:
                blob = CONTENT_ROOT / first_conflicted.relpath
                shutil.copy2(
                    blob if blob.is_file() else first_conflicted.yours_path, b)
            else:
                shutil.copy2(first_conflicted.yours_path, b)
            first_merge_argv = [
                code, "--reuse-window", "--merge",
                str(y), str(t), str(b),
                str(staging / first_conflicted.relpath),
            ]

        print(f"Opening VS Code with {len(text_conflicts)} conflict(s). "
              f"Click each file in the Source Control panel to open it "
              f"in the merge editor. Close the window when done.",
              file=sys.stderr)

        try:
            proc = subprocess.Popen(
                [code, "--new-window", "--wait", str(staging)],
            )
        except OSError as e:
            print(f"failed to launch {code}: {e}", file=sys.stderr)
            return 1

        # Pre-open the first conflict in the merge editor after the
        # workspace window has had a moment to initialise. This adds
        # a single --merge tab so the user lands ON a merge editor
        # straight away; the extension handles the SCM panel focus.
        if first_merge_argv:
            time.sleep(1.5)
            try:
                subprocess.run(first_merge_argv, check=False, timeout=5)
            except (OSError, subprocess.SubprocessError):
                pass

        try:
            proc.wait()
        except KeyboardInterrupt:
            proc.terminate()
            proc.wait()

        # Decide what happened to each file after VS Code closed.
        # Markerless final content means git auto-merged cleanly OR the
        # user resolved the conflict in the merge editor — both are
        # committable. Markers still present means the user either (a)
        # didn't open the file and left git's initial conflict state
        # alone (cur == pre, keep .shedosnew for re-run), or (b) edited
        # the file but didn't finish the resolution (warn + skip).
        saved = marker_skipped = unchanged = 0
        for c in text_conflicts:
            result = staging / c.relpath
            try:
                cur = result.read_bytes()
            except OSError:
                continue
            if not _has_conflict_markers(result):
                try:
                    save_merged_from_bytes(c, cur)
                    saved += 1
                except OSError as e:
                    print(f"save failed for {c.relpath}: {e}",
                          file=sys.stderr)
                continue
            if cur == pre[c.relpath]:
                unchanged += 1
                continue
            print(f"warning: {c.relpath} contains conflict markers; "
                  f"leaving .shedosnew in place. Re-run after cleanup.",
                  file=sys.stderr)
            marker_skipped += 1

        summary = []
        if saved:
            summary.append(f"{saved} saved")
        if unchanged:
            summary.append(f"{unchanged} unchanged (.shedosnew kept for re-run)")
        if marker_skipped:
            summary.append(f"{marker_skipped} skipped due to conflict markers")
        if summary:
            print("VS Code review complete: " + ", ".join(summary) + ".",
                  file=sys.stderr)

        # Refresh the waybar conflict count. Best-effort, mirrors save_merged.
        try:
            subprocess.run(
                ["/usr/bin/shedman", "conflicts", "--refresh-waybar"],
                check=False, timeout=2,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
        except (OSError, subprocess.SubprocessError):
            pass

        return 0
    finally:
        shutil.rmtree(staging, ignore_errors=True)


def sweep_leftover_tmps() -> int:
    """Remove stale <path>.shedosmerge.tmp.* artefacts from crashed runs."""
    removed = 0
    for dirpath, _, filenames in os.walk(HOME, followlinks=False):
        for name in filenames:
            if TMP_SUFFIX in name and ".shedosmerge.tmp." in name:
                try:
                    (Path(dirpath) / name).unlink()
                    removed += 1
                except OSError:
                    pass
    return removed


# Drafts


def save_draft(state: MergeState, current_hunk: int) -> None:
    try:
        safe_relpath(state.relpath)
    except ValueError:
        return
    dp = draft_path_for(state.relpath)
    dp.parent.mkdir(parents=True, exist_ok=True)
    data = {
        "schema": DRAFT_SCHEMA,
        "saved_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "relpath": state.relpath,
        "pkg": state.pkg,
        "yours_sha_at_load": state.yours_sha_at_load,
        "theirs_sha_at_load": state.theirs_sha_at_load,
        "base_sha_at_load": state.base_sha_at_load,
        "src_sha_at_load": state.src_sha_at_load,
        "decisions": [
            {"index": h.index, "decision": h.decision.value if h.decision else None}
            for h in state.hunks
        ],
        "current_hunk": current_hunk,
    }
    tmp = dp.with_suffix(dp.suffix + ".tmp")
    tmp.write_text(json.dumps(data, indent=2))
    os.rename(str(tmp), str(dp))


def load_draft(relpath: str) -> Optional[dict]:
    dp = draft_path_for(relpath)
    if not dp.is_file():
        return None
    try:
        data = json.loads(dp.read_text())
    except (OSError, json.JSONDecodeError):
        return None
    if data.get("schema") != DRAFT_SCHEMA:
        return None
    return data


def delete_draft(relpath: str) -> None:
    dp = draft_path_for(relpath)
    try:
        dp.unlink()
    except OSError:
        pass


# Module-level reference to the currently-active merge so a signal handler
# (SIGTERM / SIGHUP) can flush the in-progress decisions to a draft before
# the process is killed. Populated from MergeScreen.on_mount and cleared in
# on_unmount. A list is used so subordinate scopes can mutate it without
# the `global` keyword.
_active_merge_ref: list = []


def _signal_save_and_exit(signum, frame) -> None:  # noqa: ARG001
    if _active_merge_ref:
        screen = _active_merge_ref[0]
        try:
            # Read state + current live off the screen so the snapshot is
            # whatever the user had on screen at the moment of the signal.
            save_draft(screen.state, screen.current)
        except Exception as e:  # noqa: BLE001
            _log(f"signal {signum}: draft save failed: {e}")
    # Conventional exit code for signal-terminated processes.
    sys.exit(128 + int(signum))


def install_signal_handlers() -> None:
    """Install SIGTERM + SIGHUP handlers that flush a draft on forced exit.

    SIGINT (Ctrl-C) is owned by Textual — its priority binding routes to
    ``action_quit``, which in turn triggers ``MergeScreen.action_cancel``
    on the active screen and already saves a draft. This function covers
    only the non-interactive kills.
    """
    for sig_name in ("SIGTERM", "SIGHUP"):
        sig = getattr(signal, sig_name, None)
        if sig is None:
            continue
        try:
            signal.signal(sig, _signal_save_and_exit)
        except (OSError, ValueError) as e:
            _log(f"install {sig_name} handler failed: {e}")


def apply_draft(state: MergeState, draft: dict) -> bool:
    """Try to apply decisions from a draft. Returns True if applied."""
    # Only apply if load-time SHAs still match; otherwise the world moved.
    checks = [
        ("yours_sha_at_load", state.yours_sha_at_load),
        ("theirs_sha_at_load", state.theirs_sha_at_load),
        ("base_sha_at_load", state.base_sha_at_load),
        ("src_sha_at_load", state.src_sha_at_load),
    ]
    for key, cur in checks:
        if draft.get(key, "") != cur:
            return False
    by_idx = {d["index"]: d["decision"] for d in draft.get("decisions", [])}
    for h in state.hunks:
        dec = by_idx.get(h.index)
        if dec is None:
            continue
        try:
            h.decision = Side(dec)
        except ValueError:
            pass
    return True


# Process lock


class LockAcquireError(Exception):
    pass


def acquire_lock() -> int:
    LOCK_PATH.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(str(LOCK_PATH), os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        raise LockAcquireError()
    os.write(fd, f"{os.getpid()}\n".encode())
    return fd


def release_lock(fd: int) -> None:
    try:
        fcntl.flock(fd, fcntl.LOCK_UN)
    except OSError:
        pass
    os.close(fd)


# CLI entry + dispatch


def _human_size(n: int) -> str:
    if n < 1024:
        return f"{n} B"
    if n < 1024 * 1024:
        return f"{n / 1024:.1f} KB"
    return f"{n / (1024 * 1024):.2f} MB"


def cmd_list(conflicts: list[Conflict]) -> int:
    print("# path\tkind\thunks\tsize\tbase")
    text_n = bin_n = no_base_n = 0
    for c in conflicts:
        if c.kind == "binary":
            bin_n += 1
            hunks = "-"
        elif c.kind == "text":
            text_n += 1
            hunks = str(c.hunk_count) if c.hunk_count >= 0 else "?"
        else:
            hunks = "-"
        if not c.has_base and c.kind == "text":
            no_base_n += 1
        base = "yes" if c.has_base else ("-" if c.kind == "binary" else "no")
        print(f"{c.relpath}\t{c.kind}\t{hunks}\t{c.size}\t{base}")
    print(f"# summary: {len(conflicts)} conflicts ({text_n} text, {bin_n} binary, {no_base_n} no-base)")
    return 0


def populate_hunk_counts(conflicts: list[Conflict], force_2way: bool = False) -> None:
    for c in conflicts:
        if c.kind != "text":
            continue
        try:
            state = load_merge_state(c, force_2way=force_2way)
            c.hunk_count = len(state.hunks)
        except OSError:
            c.hunk_count = -1


def cmd_dry_run(conflicts: list[Conflict], force_2way: bool = False) -> int:
    for c in conflicts:
        print(f"== {c.relpath} ({c.kind}, {'3-way' if c.has_base and not force_2way else '2-way'}) ==")
        if c.kind != "text":
            print(f"  (would open {c.kind}-file modal)")
            continue
        try:
            state = load_merge_state(c, force_2way=force_2way)
        except OSError as e:
            print(f"  load failed: {e}")
            continue
        for h in state.hunks:
            base_range = f"base {h.base_start}..{h.base_end}" if not state.is_2way else "(2-way)"
            print(f"  hunk {h.index} [{h.kind}] {base_range} "
                  f"yours {h.yours_start}..{h.yours_end} theirs {h.theirs_start}..{h.theirs_end} "
                  f"default={h.decision.value if h.decision else '-'}")
    return 0


# Textual app (lazy-imported)


def _run_textual(conflicts: list[Conflict], *, start_file: Optional[str] = None,
                 walk_all: bool = False, force_2way: bool = False) -> int:
    try:
        from .review_configs_ui import run_app  # type: ignore
    except Exception:
        # Inline the Textual app below; import it from this same module.
        # We resolve the runner via globals to keep everything in one file.
        runner = globals().get("_run_app_inline")
        if runner is None:
            print("shedman config --review: Textual UI module unavailable. "
                  "Install python-textual and python-rich, or run with --list "
                  "and resolve conflicts manually.", file=sys.stderr)
            return 1
        return runner(conflicts, start_file=start_file, walk_all=walk_all,
                      force_2way=force_2way)
    return run_app(conflicts, start_file=start_file, walk_all=walk_all,
                   force_2way=force_2way)


def main(argv: Optional[list[str]] = None) -> int:
    av = argv if argv is not None else sys.argv[1:]
    if av and av[0] == "--help-summary":
        print("resolve .shedosnew dotfile conflicts with a merge TUI")
        return 0
    p = argparse.ArgumentParser(
        prog="shedman config --review",
        description="Resolve .shedosnew config conflicts with a merge TUI.",
    )
    p.add_argument("--list", action="store_true",
                   help="Print a tab-separated list of conflicts and exit.")
    p.add_argument("--all", action="store_true",
                   help="Walk every conflict sequentially (skip the file list).")
    p.add_argument("--file", metavar="PATH",
                   help="Open merge screen for one file (relpath under $HOME).")
    p.add_argument("--dry-run", action="store_true",
                   help="Load each conflict, print the computed merge plan, "
                        "change nothing.")
    p.add_argument("--no-color", action="store_true",
                   help="Force plain output (same as NO_COLOR=1).")
    p.add_argument("--2way-only", dest="two_way", action="store_true",
                   help="Ignore BASE content on disk; always run 2-way.")
    backend = p.add_mutually_exclusive_group()
    backend.add_argument("--gui", action="store_true",
                         help="Open conflicts in the VS Code merge editor. "
                              "Requires `code` (or `codium`) on PATH.")
    backend.add_argument("--tui", action="store_true",
                         help="Use the Textual TUI (default).")
    # Hidden test hook: read decisions from stdin instead of running the TUI.
    p.add_argument("--stdin-decisions", action="store_true",
                   help=argparse.SUPPRESS)
    args = p.parse_args(argv)

    if args.no_color:
        os.environ["NO_COLOR"] = "1"

    if os.geteuid() == 0:
        print("shedman config --review: refusing to run as root "
              "(this tool edits $HOME, which must remain user-owned).",
              file=sys.stderr)
        return 2

    # Acquire the process lock for any mutating operation.
    if not args.list and not args.dry_run:
        try:
            lock_fd = acquire_lock()
        except LockAcquireError:
            print(f"shedman config --review: another instance is running "
                  f"(lock at {LOCK_PATH}).", file=sys.stderr)
            return 1
    else:
        lock_fd = None

    try:
        swept = sweep_leftover_tmps()
        if swept and not args.list:
            print(f"Cleaned up {swept} stale .shedosmerge.tmp file(s) from a previous run.",
                  file=sys.stderr)

        conflicts, excluded = scan_conflicts()
        conflicts, auto_n = auto_resolve_identical(conflicts)
        if auto_n and not args.list:
            print(f"Auto-resolved {auto_n} identical-content conflict(s).",
                  file=sys.stderr)
        if excluded and not args.list:
            print(f"Note: {len(excluded)} .shedosnew file(s) live under "
                  f"excluded paths (e.g. ~/.cache, ~/.local/state) and "
                  f"won't appear in the review list.", file=sys.stderr)
            for rel in excluded[:5]:
                print(f"  ~/{rel}.shedosnew", file=sys.stderr)
            if len(excluded) > 5:
                print(f"  … and {len(excluded) - 5} more. "
                      "Delete them manually with `rm`.", file=sys.stderr)
        oversized = [c for c in conflicts if c.kind == "oversized"]
        if oversized and not args.list:
            print(f"Note: {len(oversized)} file(s) exceed the merge size "
                  f"limit ({LARGE_FILE_BYTES} bytes / {LARGE_FILE_LINES} "
                  f"lines) and will be skipped. Merge in $EDITOR, then "
                  f"`rm <file>.shedosnew`.", file=sys.stderr)
            for c in oversized[:5]:
                print(f"  ~/{c.relpath}.shedosnew", file=sys.stderr)
            if len(oversized) > 5:
                print(f"  … and {len(oversized) - 5} more.",
                      file=sys.stderr)

        if args.list:
            populate_hunk_counts(conflicts, force_2way=args.two_way)
            return cmd_list(conflicts)

        if args.dry_run:
            return cmd_dry_run(conflicts, force_2way=args.two_way)

        if args.stdin_decisions:
            return _run_stdin_decisions(conflicts, force_2way=args.two_way,
                                        start_file=args.file)

        if not conflicts:
            print("Nothing to review. All configs are in sync.")
            return 0

        if args.file:
            rel = args.file
            if rel.startswith(str(HOME) + "/"):
                rel = rel[len(str(HOME)) + 1:]
            if rel.startswith("~/"):
                rel = rel[2:]
            conflicts = [c for c in conflicts if c.relpath == rel]
            if not conflicts:
                print(f"shedman config --review: no conflict found for {args.file!r}.",
                      file=sys.stderr)
                return 1

        # TUI is the default; --gui is opt-in. The missing-binary
        # fallback to TUI still happens inside _run_vscode so an
        # explicit --gui on a system without `code` doesn't crash.
        if args.gui:
            backend = "gui"
        else:
            backend = "tui"

        if backend == "gui":
            return _run_vscode(conflicts, force_2way=args.two_way)

        if not sys.stdin.isatty() or not sys.stdout.isatty():
            print("shedman config --review: interactive TUI requires a terminal. "
                  "Try --list for a scriptable summary.", file=sys.stderr)
            return 2

        populate_hunk_counts(conflicts, force_2way=args.two_way)
        return _run_textual(conflicts, start_file=args.file, walk_all=args.all,
                            force_2way=args.two_way)
    finally:
        if lock_fd is not None:
            release_lock(lock_fd)


def _run_stdin_decisions(conflicts: list[Conflict], *, force_2way: bool,
                         start_file: Optional[str]) -> int:
    """Test harness: read tokens from stdin, apply them, save.

    Tokens (one per line): Y T BYT BTY  → per-hunk decisions
                           A T          → whole-file shortcuts
                           s              → save current file
                           n              → next file
                           q              → quit
    Unknown tokens are ignored.
    """
    if start_file:
        conflicts = [c for c in conflicts if c.relpath == start_file]
    if not conflicts:
        print("no conflicts to process", file=sys.stderr)
        return 0
    tokens = iter(sys.stdin.read().split())
    for c in conflicts:
        if c.kind != "text":
            continue
        state = load_merge_state(c, force_2way=force_2way)
        hunk_idx = 0
        while True:
            try:
                tok = next(tokens)
            except StopIteration:
                break
            if tok == "q":
                return 0
            if tok == "n":
                break
            if tok == "s":
                try:
                    save_merged(state)
                    print(f"saved {c.relpath}")
                except UnresolvedHunk as e:
                    print(f"unresolved hunk {e.hunk.index} in {c.relpath}",
                          file=sys.stderr)
                    return 1
                break
            if tok == "A":
                for h in state.hunks:
                    h.decision = Side.YOURS
                continue
            if tok == "T":
                # Ambiguous (THEIRS single-hunk vs take-all-THEIRS); in stdin
                # harness we treat 'T' as per-hunk take-theirs and 'TT' as
                # take-all-theirs to avoid the clash.
                while (hunk_idx < len(state.hunks)
                       and state.hunks[hunk_idx].decision is not None):
                    hunk_idx += 1
                if hunk_idx < len(state.hunks):
                    state.hunks[hunk_idx].decision = Side.THEIRS
                    hunk_idx += 1
                continue
            if tok == "TT":
                for h in state.hunks:
                    h.decision = Side.THEIRS
                continue
            try:
                side = Side(tok)
            except ValueError:
                continue
            # Skip hunks the classifier auto-decided; user tokens apply to
            # the remaining ones.
            while (hunk_idx < len(state.hunks)
                   and state.hunks[hunk_idx].decision is not None):
                hunk_idx += 1
            if hunk_idx < len(state.hunks):
                state.hunks[hunk_idx].decision = side
                hunk_idx += 1
    return 0



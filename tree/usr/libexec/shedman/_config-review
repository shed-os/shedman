    class HunkStrip(Static):
        def __init__(self) -> None:
            super().__init__("", id="hunk-strip")

        def update_from(self, state: MergeState, current: int) -> None:
            chars = []
            for i, h in enumerate(state.hunks):
                # Pick the base glyph from the decision (or pending).
                if h.decision is None:
                    glyph = "○"
                elif h.decision in (Side.BOTH_YT, Side.BOTH_TY):
                    glyph = f"[{THEME.both}]●[/]"
                elif h.decision == Side.YOURS:
                    glyph = f"[{THEME.added}]●[/]"
                elif h.decision == Side.THEIRS:
                    glyph = f"[{THEME.removed}]●[/]"
                else:
                    glyph = "○"  # defensive; shouldn't happen post-SKIP-removal

                # If this is also the current hunk, overlay reverse-bold so the
                # user sees both states at once (last-hunk-looks-unsaved fix).
                if i == current:
                    glyph = f"[b reverse]{glyph}[/]"

                chars.append(glyph)
            dots = " ".join(chars)
            legend = "  (● resolved  ◉ current  ○ pending)"
            # Cap total width to terminal columns using east-asian-aware math
            # (the dot glyphs render ambiguous-width; spaces + ASCII legend
            # are single-cell). The widget itself is a one-line Static, so
            # overflow would silently clip; do it ourselves so the user sees
            # an ellipsis instead of a mystery cut.
            term_cols = self.size.width or shutil.get_terminal_size((80, 24)).columns
            padding = 2
            dots_budget = max(10, term_cols - display_width(legend) - padding)
            if display_width(dots) > dots_budget:
                dots = truncate_to_width(dots, dots_budget)
            self.update(dots + legend)

    # ----- Per-row rendering for the aligned 3-pane viewer -----------------
    #
    # The left (YOURS) and right (THEIRS) panes always show their own side's
    # content. The middle pane is a LIVE RESULT PREVIEW: for every hunk it
    # reflects the user's current decision (y/t/b/B/x); cells mirror the
    # chosen side so the user sees the merged output take shape as they
    # make calls. Undecided hunks are marked with a yellow "?" so pending
    # work is obvious. Outside hunks the middle pane shows base (ancestor)
    # content unchanged.
    #
    # Per-cell ``tag`` (set by ``build_aligned_rows`` or substituted by the
    # decision logic) drives the color/marker in git-diff fashion:
    #   equal / ctx    →  neutral text, no marker
    #   add            →  green "+" + green text   (side introduced this line)
    #   del            →  red   "-" + red   text   (side deleted this base line)
    #   und            →  yellow "?" + yellow text (hunk still undecided; only
    #                                              ever appears in middle pane)
    #
    # Padding rows (cells with ``text is None``) draw a dim "~" placeholder
    # so the three panes stay vertically aligned when one side of a hunk has
    # fewer lines than another. The current hunk (the one decision keys
    # affect) gets a surface0 background across every pane so the user always
    # knows where focus is.

    GUTTER_WIDTH = 4   # columns for line number
    MARKER_WIDTH = 3   # columns for " + " / " - " / "   "

    def _effective_middle_cell(row: AlignedRow,
                               decisions: dict[int, Optional[Side]]
                               ) -> Cell:
        """Compute what the middle (RESULT) pane should show for this row.

        - Context rows (no hunk): base cell unchanged (or yours in 2-way mode).
        - Undecided hunk: base content with tag="und" so user sees yellow "?".
        - YOURS: mirror yours cell.
        - THEIRS: mirror theirs cell.
        - BOTH_YT: prefer yours; fall back to theirs when yours is padding.
        - BOTH_TY: prefer theirs; fall back to yours when theirs is padding.

        The fallback matters on rows where only one side has an insert — we
        don't want to drop it to padding when the user has said "take both".

        In 2-way mode there is no BASE; we walk YOURS-space, so `row.base`
        cells are padding. Fall back to `row.yours` so the preview pane
        has content outside hunks too.
        """
        # 2-way: row.base is padding (no text, no lineno). Treat row.yours
        # as the surrounding context instead.
        fallback = row.base if (row.base.text is not None
                                or row.base.lineno is not None) else row.yours
        if row.hunk_index is None:
            return fallback
        decision = decisions.get(row.hunk_index)
        if decision is None:
            if fallback.text is None:
                return Cell(None, None, tag="equal")
            return Cell(lineno=fallback.lineno, text=fallback.text, tag="und")
        if decision == Side.YOURS:
            return row.yours
        if decision == Side.THEIRS:
            return row.theirs
        if decision == Side.BOTH_YT:
            return row.yours if row.yours.text is not None else row.theirs
        if decision == Side.BOTH_TY:
            return row.theirs if row.theirs.text is not None else row.yours
        return fallback

    def _render_cell(cell: Cell, is_hunk: bool, is_current: bool) -> Text:
        line = Text()
        bg = THEME.surface if is_current else None

        # Pick foreground + marker by tag.
        if cell.tag == "add":
            fg, marker = THEME.added,   " + "
        elif cell.tag == "del":
            fg, marker = THEME.removed, " - "
        elif cell.tag == "und":
            fg, marker = THEME.warning, " ? "
        elif cell.tag == "ctx":
            fg, marker = THEME.dim,     "   "
        else:  # "equal"
            fg, marker = (THEME.text if is_hunk else THEME.dim), "   "

        style = f"{fg} on {bg}" if bg else fg

        if cell.text is None:
            dim_style = f"{THEME.dim} on {bg}" if bg else THEME.dim
            line.append(" " * GUTTER_WIDTH, style=dim_style)
            line.append(" ~ ", style=dim_style)
            line.append("\n", style=dim_style)
            return line

        body = cell.text
        if len(body) > LONG_LINE_HL_CUTOFF:
            body = body[:LONG_LINE_HL_CUTOFF] + "…"

        gutter = (f"{cell.lineno:>{GUTTER_WIDTH}d}"
                  if cell.lineno is not None else " " * GUTTER_WIDTH)
        line.append(gutter, style=style)
        line.append(marker, style=style)
        if cell.spans is not None:
            # Walk word-level spans: equal runs use the line's base style,
            # changed runs get bold for inline emphasis. The whole line's
            # foreground colour stays the cell's tag colour (red/green).
            for span_kind, span_text in cell.spans:
                if span_kind == "equal":
                    line.append(span_text, style=style)
                else:
                    line.append(span_text, style=f"bold {style}")
            line.append("\n", style=style)
        elif cell.syntax is not None:
            for palette_key, span_text in cell.syntax:
                tok_fg = PALETTE.get(palette_key, PALETTE["text"])
                tok_style = f"{tok_fg} on {bg}" if bg else tok_fg
                line.append(span_text, style=tok_style)
            line.append("\n", style=style)
        else:
            line.append(body + "\n", style=style)
        return line

    def render_pane_text(rows: list[AlignedRow], side: str,
                         current_hunk: Optional[int],
                         decisions: Optional[dict[int, Optional[Side]]] = None,
                         wrap: bool = False,
                         ) -> Text:
        # Lines are constructed with an explicit '\n'; ``no_wrap`` flips
        # between "truncate/overflow-x scroll" (default) and "soft-wrap at
        # container width" (when the user presses z). Aggregate Text owns
        # the flag so Rich applies it uniformly to every line chunk.
        out = Text(no_wrap=not wrap, overflow="ignore" if not wrap else "fold")
        side_attr = side.lower()
        for row in rows:
            is_current = (current_hunk is not None
                          and row.hunk_index == current_hunk)
            if side == "BASE" and decisions is not None:
                cell = _effective_middle_cell(row, decisions)
            else:
                cell = getattr(row, side_attr)
            out.append_text(_render_cell(cell, row.is_hunk, is_current))
        return out

    class DiffPane(VerticalScroll):
        """One side of the merge view: YOURS, BASE, or THEIRS.

        A scrollable container with a single Static body. Scroll state is
        driven from the screen (not the pane) so the three panes move in
        lockstep when the user presses j/k/page-up/page-down/home/end.

        ``can_focus = False`` is critical: ``VerticalScroll`` is focusable
        by default, and when a pane has focus it intercepts arrow/scroll
        keys and our decision keys (y/t/b/B/x) before the MergeScreen
        bindings get a chance to fire. Keeping focus on the screen lets
        every key route through screen-level BINDINGS.
        """

        can_focus = False
        can_focus_children = False

        def __init__(self, title: str, *, kind: str) -> None:
            super().__init__(id=f"pane-{kind.lower()}")
            self._kind = kind
            self.border_title = title
            self.add_class("pane")
            self.add_class(f"pane-{kind.lower()}")
            self.body = Static("(loading)", expand=True)

        def compose(self) -> ComposeResult:
            yield self.body

        def set_content(self, text: Text) -> None:
            self.body.update(text)


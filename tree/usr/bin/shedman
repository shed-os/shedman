#!/usr/bin/env bash
# shedman; unified dispatcher for ShedOS utilities.
#
# Every executable file under the configured libexec directory is a
# subcommand. `shedman foo args…` execs <libexec>/foo with argv preserved.
# Packages drop additional subcommands by installing files to that
# directory and a declaration beside it saying whose it is; `shedman help`
# lists what has been declared.
#
# Names starting with `_` are internal implementation helpers: declared,
# invokable as `shedman _name`, and kept out of `shedman help`.
#
# An executable nobody declared still runs — the dispatcher is not the place
# to break a machine over metadata — but it is not listed, and
# `shedman doctor` names it.

set -uo pipefail

CONFIG=${SHEDMAN_CONFIG:-/etc/shedman/shedman.toml}

_config() {
    # One `key = "value"` line out of the config file. The default is the
    # answer whenever the file is absent, unreadable or silent about the key,
    # so nothing here can leave shedman unable to run.
    local key=$1 value
    value=$(sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*\"\([^\"]*\)\".*/\1/p" \
        "$CONFIG" 2>/dev/null | head -1)
    printf '%s\n' "${value:-$2}"
}

LIBEXEC=$(_config libexec /usr/libexec/shedman)
PACKAGE=$(_config package shedman)
VERBS=$(_config verbs /usr/share/shedman/verbs.d)
PROG=$(basename "$0")

_usage() {
    cat <<EOF
Usage: $PROG <command> [args…]
       $PROG help [command]
       $PROG version

Run '$PROG help' to list all subcommands.
EOF
}

_declarations() {
    # `<name><TAB><description>` per declared verb. The file name is not the
    # verb name — the declaration says which verb it is — so two packages
    # claiming one name is a disagreement no install order settles, and it
    # goes to stderr rather than being decided here.
    local -a decls=("$VERBS"/*.toml)
    [[ -e ${decls[0]} ]] || return 0
    awk -v prog="$PROG" '
        function value(line,   v) {
            v = line
            sub(/^[^=]*=[[:space:]]*/, "", v)
            gsub(/^"|"$/, "", v)
            return v
        }
        function emit(   a, b) {
            if (name == "") return
            if (name in owner) {
                # Named in a fixed order: which declaration the directory
                # listing reached first says nothing about the problem.
                a = owner[name]; b = pkg
                if (a > b) { a = pkg; b = owner[name] }
                printf "%s: %s is declared by both %s and %s\n",
                    prog, name, a, b > "/dev/stderr"
            }
            else
                printf "%s\t%s\n", name, desc
            owner[name] = pkg
        }
        FILENAME != file { if (file != "") emit(); file = FILENAME; name = pkg = desc = "" }
        /^[[:space:]]*name[[:space:]]*=/        { name = value($0) }
        /^[[:space:]]*package[[:space:]]*=/     { pkg  = value($0) }
        /^[[:space:]]*description[[:space:]]*=/ { desc = value($0) }
        END { emit() }
    ' "${decls[@]}" | LC_ALL=C sort
}

_list() {
    local name desc
    printf 'Available subcommands:\n'
    while IFS=$'\t' read -r name desc; do
        [[ $name == _* ]] && continue
        if [[ -n $desc ]]; then
            printf '  %-16s  %s\n' "$name" "$desc"
        else
            printf '  %s\n' "$name"
        fi
    done < <(_declarations)
}

_did_you_mean() {
    # Print the closest matches from the subcommand index. Uses a simple
    # substring match; if the user typed `updat` we want to suggest
    # `update` and `updates`. A full edit-distance pass isn't worth the
    # awk dance for a handful of names.
    local needle=$1 name hits=()
    while IFS=$'\t' read -r name _; do
        [[ $name == _* ]] && continue
        if [[ $name == *"$needle"* || $needle == *"$name"* ]]; then
            hits+=("$name")
        fi
    done < <(_declarations)
    if (( ${#hits[@]} > 0 )); then
        printf '\nDid you mean:\n'
        printf '  %s\n' "${hits[@]}"
    fi
}

_version() {
    # Read pkgver from the installed package. Fall back to "unknown" in
    # development when running from the repo tree.
    local v
    if v=$(pacman -Qi "$PACKAGE" 2>/dev/null | awk -F' *: *' '$1=="Version"{print $2; exit}'); then
        [[ -n $v ]] && { printf '%s\n' "$v"; return; }
    fi
    printf 'unknown\n'
}

if (( $# == 0 )); then
    _list
    exit 0
fi

cmd=$1
shift

case "$cmd" in
    -h|--help|help)
        if (( $# == 0 )); then
            _list
            exit 0
        fi
        target=$LIBEXEC/$1
        if [[ -x $target && -f $target ]]; then
            exec "$target" --help
        fi
        printf '%s: no such subcommand: %s\n' "$PROG" "$1" >&2
        exit 2
        ;;
    -V|--version|version)
        _version
        exit 0
        ;;
esac

target=$LIBEXEC/$cmd
if [[ -x $target && -f $target ]]; then
    exec "$target" "$@"
fi

printf '%s: unknown command: %s\n' "$PROG" "$cmd" >&2
_did_you_mean "$cmd" >&2
exit 2
